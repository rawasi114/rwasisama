<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_rawasi_eos_settlement" model="ir.sequence">
            <field name="name">تسوية نهاية الخدمة</field>
            <field name="code">rawasi.eos.settlement</field>
            <field name="prefix">EOS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_rawasi_wps_batch" model="ir.sequence">
            <field name="name">دفعة حماية الأجور</field>
            <field name="code">rawasi.wps.batch</field>
            <field name="prefix">WPS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_rawasi_eos_provision_run" model="ir.sequence">
            <field name="name">دفعة مخصص نهاية الخدمة</field>
            <field name="code">rawasi.eos.provision.run</field>
            <field name="prefix">EOSP/%(year)s%(month)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
