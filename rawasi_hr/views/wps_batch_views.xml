<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rawasi_wps_batch_list" model="ir.ui.view">
        <field name="name">rawasi.wps.batch.list</field>
        <field name="model">rawasi.wps.batch</field>
        <field name="arch" type="xml">
            <list string="دفعات حماية الأجور">
                <field name="currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="year"/>
                <field name="month"/>
                <field name="employee_count"/>
                <field name="total_net"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-info="state == 'generated'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_rawasi_wps_batch_form" model="ir.ui.view">
        <field name="name">rawasi.wps.batch.form</field>
        <field name="model">rawasi.wps.batch</field>
        <field name="arch" type="xml">
            <form string="دفعة حماية الأجور">
                <header>
                    <button name="action_populate_lines" type="object"
                            string="تعبئة الموظفين" invisible="state != 'draft'"/>
                    <button name="action_generate_file" type="object"
                            string="توليد الملف" class="btn-primary"
                            invisible="state not in ('draft','generated')"/>
                    <button name="action_mark_sent" type="object"
                            string="تأشير بالإرسال" invisible="state != 'generated'"/>
                    <button name="action_cancel" type="object" string="إلغاء"
                            invisible="state == 'cancel'"/>
                    <button name="action_reset_draft" type="object" string="إعادة لمسودة"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,sent"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="الفترة">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="month" readonly="state != 'draft'"/>
                            <field name="year" readonly="state != 'draft'"/>
                        </group>
                        <group string="الإجماليات">
                            <field name="currency_id" invisible="1"/>
                            <field name="employee_count"/>
                            <field name="total_net"/>
                        </group>
                    </group>
                    <group string="الملف المُولَّد" invisible="not sif_file">
                        <field name="sif_filename" readonly="1"/>
                        <field name="sif_file" filename="sif_filename" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="سطور الرواتب">
                            <field name="line_ids" readonly="state not in ('draft','generated')">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="employee_id"/>
                                    <field name="iban"/>
                                    <field name="basic_salary"/>
                                    <field name="housing_allowance"/>
                                    <field name="other_allowance"/>
                                    <field name="deductions"/>
                                    <field name="net_salary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rawasi_wps_batch" model="ir.actions.act_window">
        <field name="name">حماية الأجور</field>
        <field name="res_model">rawasi.wps.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أنشئ دفعة حماية أجور جديدة</p>
            <p>عبّئ الموظفين، ثم ولّد ملف SIF لرفعه للبنك أو منصة مدد.</p>
        </field>
    </record>

</odoo>
