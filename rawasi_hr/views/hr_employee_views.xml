<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_form_rawasi" model="ir.ui.view">
        <field name="name">hr.employee.form.rawasi</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="الأجر وحماية الأجور" name="rawasi_wage">
                    <group>
                        <group string="تركيبة الأجر (ر.س)">
                            <field name="currency_id" invisible="1"/>
                            <field name="rawasi_basic_wage"/>
                            <field name="rawasi_housing_allowance"/>
                            <field name="rawasi_other_allowance"/>
                            <field name="rawasi_total_wage"/>
                        </group>
                        <group string="بيانات حماية الأجور">
                            <field name="rawasi_mol_number"/>
                            <field name="rawasi_bank_iban"/>
                            <field name="rawasi_bank_code"/>
                        </group>
                        <group string="نهاية الخدمة">
                            <field name="rawasi_join_date"/>
                            <field name="rawasi_eos_accrued"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
