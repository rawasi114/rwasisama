# ==========================================================================
# Rawasi Sama ERP — Environment Variables (نسخة المثال)
# انسخ هذا الملف إلى .env واملأ القيم. لا تُضِف .env إلى Git.
# ==========================================================================

# --- Application ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
# عنوان الـ API كما تراه الواجهة الأمامية
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql://rawasi:rawasi@localhost:5432/rawasi_erp?schema=public

# --- Redis 7 (BullMQ / cache) ---
REDIS_URL=redis://localhost:6379

# --- Auth (JWT + Refresh) ---
# غيّر هذه القيم في الإنتاج إلى أسرار قوية عشوائية
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12

# --- Seed admin user (يُنشأ عبر prisma db seed) ---
SEED_ADMIN_EMAIL=admin@rawasi-sama.sa
SEED_ADMIN_PASSWORD=Admin@12345

# --- File storage ---
# local = تخزين على القرص للتطوير | s3 = متوافق مع S3/MinIO للإنتاج
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.localstorage
# تُستخدم فقط عند STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rawasi-erp
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Rate limiting (طلبات/دقيقة لكل IP) ---
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
