# ─────────────────────────────────────────────────────────────
# Rawasi ERP — Environment Variables (copy to .env and adjust)
# ─────────────────────────────────────────────────────────────

# Node
NODE_ENV=development

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://rawasi:rawasi_dev_pw@localhost:5432/rawasi_erp?schema=public"

# Redis (BullMQ / cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# API
API_PORT=4000
API_GLOBAL_PREFIX=api

# JWT — CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# File storage — driver: "local" | "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3 / MinIO (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rawasi-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Web (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Seed admin (used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@rawasi-sama.sa
SEED_ADMIN_PASSWORD=Admin@12345
