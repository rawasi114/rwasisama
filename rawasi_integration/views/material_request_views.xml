<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- زر «تصنيع داخلي بالورشة» على طلب مواد المقاولات -->
        <record id="view_material_request_form_internal" model="ir.ui.view">
            <field name="name">rawasi.material.request.form.internal</field>
            <field name="model">rawasi.material.request</field>
            <field name="inherit_id" ref="rawasi_construction.view_material_request_form"/>
            <field name="arch" type="xml">
                <button name="action_forward_purchase" position="before">
                    <button name="action_internal_workshop_quote" type="object"
                            string="تصنيع داخلي بالورشة" class="btn-primary"
                            invisible="procurement_type != 'in_house_workshop' or state != 'approved_budget'"/>
                </button>
            </field>
        </record>

    </data>
</odoo>
