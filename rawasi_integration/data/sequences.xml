<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_internal_workshop_order" model="ir.sequence">
            <field name="name">أمر تصنيع داخلي</field>
            <field name="code">rawasi.internal.workshop.order</field>
            <field name="prefix">IWO-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- الشريك الداخلي «الشركة - مشاريع المقاولات» (يُنشأ مرة واحدة) -->
        <record id="partner_internal_construction" model="res.partner">
            <field name="name">رواسي سما — مشاريع المقاولات (داخلي)</field>
            <field name="is_company" eval="True"/>
            <field name="comment">شريك داخلي لأوامر البيع بين الورشة والمقاولات.</field>
        </record>

    </data>
</odoo>
