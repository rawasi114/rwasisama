<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_delivery_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="simple_manufacturing.rawasi_layout">
                    <t t-set="doc_code">RS-WS-19</t>
                    <t t-set="doc_title">إذن خروج وتسليم</t>
                    <t t-set="doc_title_en">Delivery / Gate Pass</t>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">1</t><t t-set="sec_ar">بيانات التسليم</t><t t-set="sec_en">Delivery Data</t>
                    </t>
                    <table class="rs-info">
                        <tr>
                            <td class="lbl">العميل</td><td t-out="o.partner_id.name or ''"/>
                            <td class="lbl">أمر التصنيع</td><td t-out="o.order_id.name or ''"/>
                        </tr>
                        <tr>
                            <td class="lbl">العنوان</td><td t-out="o.delivery_address or ''"/>
                            <td class="lbl">التاريخ المجدول</td><td><span t-field="o.scheduled_date"/></td>
                        </tr>
                    </table>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">2</t><t t-set="sec_ar">البنود</t><t t-set="sec_en">Lines</t>
                    </t>
                    <table class="rs-table">
                        <tr><th style="width:8%">م.</th><th>المنتج</th><th style="width:14%">الكمية</th>
                            <th style="width:16%">سعر الوحدة</th><th style="width:16%">الإجمالي</th></tr>
                        <tr t-foreach="o.line_ids" t-as="l">
                            <td t-out="l_index + 1"/><td t-out="l.product_id.display_name or ''"/>
                            <td t-out="l.qty"/><td t-out="l.unit_price"/><td t-out="l.amount"/>
                        </tr>
                    </table>
                    <table class="rs-sign">
                        <tr>
                            <td><div class="role">أمين المستودع</div></td>
                            <td>
                                <div class="role">المستلم</div>
                                <div t-out="o.customer_sign_name or ''"/>
                                <img t-if="o.customer_signature" t-att-src="image_data_uri(o.customer_signature)"/>
                            </td>
                            <td><div class="role">حارس البوابة</div></td>
                        </tr>
                    </table>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_delivery" model="ir.actions.report">
        <field name="name">إذن تسليم</field>
        <field name="model">simple.mrp.delivery</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">simple_manufacturing.report_delivery_document</field>
        <field name="report_file">simple_manufacturing.report_delivery_document</field>
        <field name="binding_model_id" ref="model_simple_mrp_delivery"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_simple_mrp"/>
    </record>

</odoo>
