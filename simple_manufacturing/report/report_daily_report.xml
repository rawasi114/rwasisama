<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_daily_report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="simple_manufacturing.rawasi_layout">
                    <t t-set="doc_code">RS-WS-06</t>
                    <t t-set="doc_title">التقرير اليومي للورشة</t>
                    <t t-set="doc_title_en">Daily Report</t>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">1</t><t t-set="sec_ar">البيانات</t><t t-set="sec_en">Data</t>
                    </t>
                    <table class="rs-info">
                        <tr>
                            <td class="lbl">التاريخ</td><td><span t-field="o.date"/></td>
                            <td class="lbl">الورشة</td><td t-out="o.workshop or ''"/>
                        </tr>
                        <tr>
                            <td class="lbl">الطقس</td><td t-out="o.weather or ''"/>
                            <td class="lbl">عدد الطاقم</td><td t-out="o.crew_count"/>
                        </tr>
                    </table>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">2</t><t t-set="sec_ar">الإنجازات</t><t t-set="sec_en">Progress</t>
                    </t>
                    <table class="rs-table">
                        <tr><th style="width:6%">م.</th><th style="width:16%">أمر التشغيل</th><th>الوصف</th>
                            <th style="width:10%">المخطط</th><th style="width:10%">المنجز</th>
                            <th style="width:10%">%</th><th style="width:10%">المتبقي</th></tr>
                        <tr t-foreach="o.line_ids" t-as="l">
                            <td t-out="l_index + 1"/><td t-out="l.wo_ref or ''"/><td t-out="l.description or ''"/>
                            <td t-out="l.planned"/><td t-out="l.done"/><td t-out="l.completion"/><td t-out="l.remaining"/>
                        </tr>
                    </table>
                    <div class="rs-note" t-out="o.issues or ''"/>
                    <div class="rs-note" t-out="o.plan_tomorrow or ''"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_daily_report" model="ir.actions.report">
        <field name="name">التقرير اليومي</field>
        <field name="model">simple.mrp.daily.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">simple_manufacturing.report_daily_report_document</field>
        <field name="report_file">simple_manufacturing.report_daily_report_document</field>
        <field name="binding_model_id" ref="model_simple_mrp_daily_report"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_simple_mrp"/>
    </record>

</odoo>
