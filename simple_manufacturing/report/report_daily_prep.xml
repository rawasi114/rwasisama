<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_daily_prep_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="simple_manufacturing.rawasi_layout">
                    <t t-set="doc_code">RS-WS-05</t>
                    <t t-set="doc_title">التحضير اليومي للورشة</t>
                    <t t-set="doc_title_en">Daily Preparation</t>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">1</t><t t-set="sec_ar">البيانات</t><t t-set="sec_en">Data</t>
                    </t>
                    <table class="rs-info">
                        <tr>
                            <td class="lbl">التاريخ</td><td><span t-field="o.date"/></td>
                            <td class="lbl">الورشة</td><td t-out="o.workshop or ''"/>
                        </tr>
                        <tr>
                            <td class="lbl">مشرف الوردية</td><td t-out="o.shift_supervisor or ''"/>
                            <td class="lbl">الطاقم المتاح</td><td t-out="o.available_crew"/>
                        </tr>
                    </table>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">2</t><t t-set="sec_ar">الأعمال المخططة</t><t t-set="sec_en">Tasks</t>
                    </t>
                    <table class="rs-table">
                        <tr><th style="width:6%">م.</th><th style="width:16%">أمر التشغيل</th><th>المهمة</th>
                            <th style="width:16%">المسؤول</th><th style="width:10%">الساعات</th><th style="width:18%">المخرج</th></tr>
                        <tr t-foreach="o.line_ids" t-as="l">
                            <td t-out="l_index + 1"/><td t-out="l.wo_ref or ''"/><td t-out="l.task or ''"/>
                            <td t-out="l.assigned_to or ''"/><td t-out="l.hours"/><td t-out="l.expected_output or ''"/>
                        </tr>
                    </table>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">3</t><t t-set="sec_ar">الجاهزية</t><t t-set="sec_en">Readiness</t>
                    </t>
                    <div>
                        <span class="rs-chk"><t t-out="'☑' if o.materials_ready else '☐'"/> مواد متوفرة</span>
                        <span class="rs-chk"><t t-out="'☑' if o.drawings_approved else '☐'"/> مخططات معتمدة</span>
                        <span class="rs-chk"><t t-out="'☑' if o.toolbox_done else '☐'"/> اجتماع سلامة</span>
                        <span class="rs-chk"><t t-out="'☑' if o.ppe_verified else '☐'"/> أدوات الحماية</span>
                        <span class="rs-chk"><t t-out="'☑' if o.targets_reviewed else '☐'"/> مراجعة الأهداف</span>
                    </div>
                    <div class="rs-note" t-out="o.bottlenecks or ''"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_daily_prep" model="ir.actions.report">
        <field name="name">التحضير اليومي</field>
        <field name="model">simple.mrp.daily.prep</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">simple_manufacturing.report_daily_prep_document</field>
        <field name="report_file">simple_manufacturing.report_daily_prep_document</field>
        <field name="binding_model_id" ref="model_simple_mrp_daily_prep"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_simple_mrp"/>
    </record>

</odoo>
