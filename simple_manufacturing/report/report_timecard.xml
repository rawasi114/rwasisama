<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_timecard_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="simple_manufacturing.rawasi_layout">
                    <t t-set="doc_code">RS-WS-08</t>
                    <t t-set="doc_title">بطاقة وقت العامل</t>
                    <t t-set="doc_title_en">Job Time Card</t>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">1</t><t t-set="sec_ar">البيانات</t><t t-set="sec_en">Data</t>
                    </t>
                    <table class="rs-info">
                        <tr>
                            <td class="lbl">اسم العامل</td><td t-out="o.worker_name or ''"/>
                            <td class="lbl">البصمة</td><td t-out="o.badge_id or ''"/>
                        </tr>
                        <tr>
                            <td class="lbl">المهنة</td><td t-out="o.trade or ''"/>
                            <td class="lbl">نهاية الأسبوع</td><td><span t-field="o.week_ending"/></td>
                        </tr>
                    </table>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">2</t><t t-set="sec_ar">توزيع الساعات</t><t t-set="sec_en">Hours</t>
                    </t>
                    <table class="rs-table">
                        <tr><th style="width:6%">م.</th><th style="width:14%">أمر التشغيل</th><th>المهمة</th>
                            <th>السبت</th><th>الأحد</th><th>الإثنين</th><th>الثلاثاء</th><th>الأربعاء</th><th>الخميس</th><th>الإجمالي</th></tr>
                        <tr t-foreach="o.line_ids" t-as="l">
                            <td t-out="l_index + 1"/><td t-out="l.wo_ref or ''"/><td t-out="l.task or ''"/>
                            <td t-out="l.sat"/><td t-out="l.sun"/><td t-out="l.mon"/><td t-out="l.tue"/>
                            <td t-out="l.wed"/><td t-out="l.thu"/><td t-out="l.total"/>
                        </tr>
                    </table>
                    <table class="rs-info">
                        <tr>
                            <td class="lbl">عادية</td><td t-out="o.regular_hours"/>
                            <td class="lbl">إضافية</td><td t-out="o.overtime_hours"/>
                            <td class="lbl">إجمالي الأسبوع</td><td t-out="o.week_total"/>
                        </tr>
                    </table>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_timecard" model="ir.actions.report">
        <field name="name">بطاقة وقت</field>
        <field name="model">simple.mrp.timecard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">simple_manufacturing.report_timecard_document</field>
        <field name="report_file">simple_manufacturing.report_timecard_document</field>
        <field name="binding_model_id" ref="model_simple_mrp_timecard"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_simple_mrp"/>
    </record>

</odoo>
