<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_survey_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="simple_manufacturing.rawasi_layout">
                    <t t-set="doc_code">RS-WS-10</t>
                    <t t-set="doc_title">نموذج معاينة وتفصيل</t>
                    <t t-set="doc_title_en">Site Survey</t>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">1</t><t t-set="sec_ar">بيانات المعاينة</t><t t-set="sec_en">Survey</t>
                    </t>
                    <table class="rs-info">
                        <tr>
                            <td class="lbl">العميل</td><td t-out="o.partner_id.name or ''"/>
                            <td class="lbl">المشروع</td><td t-out="o.project or ''"/>
                        </tr>
                        <tr>
                            <td class="lbl">الموقع</td><td t-out="o.site_address or ''"/>
                            <td class="lbl">التاريخ</td><td><span t-field="o.date"/></td>
                        </tr>
                        <tr>
                            <td class="lbl">القائم بالمعاينة</td><td t-out="o.surveyor_id.name or ''"/>
                            <td class="lbl">إجمالي المساحة</td><td t-out="o.total_area"/>
                        </tr>
                    </table>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">2</t><t t-set="sec_ar">القياسات</t><t t-set="sec_en">Measurements</t>
                    </t>
                    <table class="rs-table">
                        <tr><th style="width:6%">م.</th><th style="width:16%">الموقع</th><th>الوصف</th>
                            <th>العرض</th><th>الارتفاع</th><th>العمق</th><th>العدد</th><th>المساحة</th></tr>
                        <tr t-foreach="o.line_ids" t-as="l">
                            <td t-out="l_index + 1"/><td t-out="l.location or ''"/><td t-out="l.description or ''"/>
                            <td t-out="l.width"/><td t-out="l.height"/><td t-out="l.depth"/>
                            <td t-out="l.quantity"/><td t-out="l.area"/>
                        </tr>
                    </table>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_survey" model="ir.actions.report">
        <field name="name">معاينة</field>
        <field name="model">simple.mrp.survey</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">simple_manufacturing.report_survey_document</field>
        <field name="report_file">simple_manufacturing.report_survey_document</field>
        <field name="binding_model_id" ref="model_simple_mrp_survey"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_simple_mrp"/>
    </record>

</odoo>
