<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_manufacturing_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="simple_manufacturing.rawasi_layout">
                    <t t-set="doc_code">RS-WS-01</t>
                    <t t-set="doc_title">أمر تشغيل / تصنيع</t>
                    <t t-set="doc_title_en">Manufacturing Order</t>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">1</t><t t-set="sec_ar">بيانات الأمر</t><t t-set="sec_en">Order Data</t>
                    </t>
                    <table class="rs-info">
                        <tr>
                            <td class="lbl">المنتج</td><td t-out="o.product_id.display_name or ''"/>
                            <td class="lbl">الكمية</td><td t-out="o.product_qty"/>
                        </tr>
                        <tr>
                            <td class="lbl">العميل</td><td t-out="o.partner_id.name or ''"/>
                            <td class="lbl">أمر البيع</td><td t-out="o.sale_order_id.name or ''"/>
                        </tr>
                        <tr>
                            <td class="lbl">التاريخ المخطط</td><td><span t-field="o.date_planned"/></td>
                            <td class="lbl">الحالة</td><td><span t-field="o.state"/></td>
                        </tr>
                    </table>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">2</t><t t-set="sec_ar">المكوّنات</t><t t-set="sec_en">Components</t>
                    </t>
                    <table class="rs-table">
                        <tr><th style="width:8%">م.</th><th>المكوّن</th><th style="width:18%">المطلوب</th>
                            <th style="width:18%">المتاح</th><th style="width:14%">الوحدة</th></tr>
                        <tr t-foreach="o.component_line_ids" t-as="l">
                            <td t-out="l_index + 1"/><td t-out="l.component_id.display_name or ''"/>
                            <td t-out="l.qty"/><td t-out="l.available_qty"/><td t-out="l.uom_name or ''"/>
                        </tr>
                    </table>
                    <table class="rs-sign">
                        <tr>
                            <td><div class="role">المُعِدّ</div></td>
                            <td><div class="role">مشرف الورشة</div></td>
                            <td><div class="role">مدير العمليات</div></td>
                        </tr>
                    </table>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_manufacturing_order" model="ir.actions.report">
        <field name="name">أمر التصنيع</field>
        <field name="model">simple.mrp.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">simple_manufacturing.report_manufacturing_order_document</field>
        <field name="report_file">simple_manufacturing.report_manufacturing_order_document</field>
        <field name="binding_model_id" ref="model_simple_mrp_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_simple_mrp"/>
    </record>

</odoo>
