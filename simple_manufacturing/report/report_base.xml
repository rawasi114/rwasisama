<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_simple_mrp" model="report.paperformat">
        <field name="name">Simple MRP A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_spacing">6</field>
        <field name="dpi">90</field>
    </record>

    <!-- التنسيق وهوية رواسي سما + خط Tajawal -->
    <template id="rawasi_style">
        <style>
            /*
              خط Tajawal: ضع ملفّي الخط في static/src/fonts ليُحمّلا محلياً.
              عند غيابهما يُستخدم خط عربي افتراضي تلقائياً (fallback) فلا تظهر دوائر.
            */
            @font-face { font-family:'Tajawal'; font-weight:400; font-style:normal;
                src:url('/simple_manufacturing/static/src/fonts/Tajawal-Regular.ttf'); }
            @font-face { font-family:'Tajawal'; font-weight:700; font-style:normal;
                src:url('/simple_manufacturing/static/src/fonts/Tajawal-Bold.ttf'); }

            .rs-doc { direction: rtl; font-family:'Tajawal', sans-serif; color:#2b2b2b; font-size:11px; }
            .rs-doc * { box-sizing: border-box; }
            .rs-header { background:#2f3a48; color:#fff; padding:8px 12px; border-radius:4px;
                         display:flex; justify-content:space-between; align-items:center; }
            .rs-header .rs-code { color:#c2a24a; font-size:10px; font-weight:bold; min-width:120px; }
            .rs-header .rs-code .rs-rev { color:#cfd6df; font-weight:normal; }
            .rs-header .rs-center { text-align:center; flex:1; }
            .rs-header .rs-docno { color:#c2a24a; font-size:12px; font-weight:bold; }
            .rs-header .rs-title { font-size:15px; font-weight:bold; }
            .rs-header .rs-title-en { font-size:9px; color:#cfd6df; }
            .rs-header .rs-co { text-align:left; min-width:150px; font-size:11px; font-weight:bold; }
            .rs-header .rs-co .rs-co-en { color:#c2a24a; font-size:9px; font-weight:normal; }
            .rs-goldbar { height:3px; background:#c2a24a; margin:0 0 8px 0; }
            .rs-footer { border-top:1px solid #c9c9c9; color:#888; font-size:9px;
                         text-align:center; padding-top:4px; margin-top:14px; }

            .rs-secbar { background:#2f3a48; color:#fff; padding:3px 10px; margin:10px 0 4px 0;
                         border-right:4px solid #c2a24a; font-size:11px; font-weight:bold;
                         display:flex; justify-content:space-between; }
            .rs-secbar .rs-sec-en { color:#c2a24a; font-weight:normal; font-size:9px; }

            table.rs-info { width:100%; border-collapse:collapse; margin-bottom:4px; }
            table.rs-info td { border:1px solid #c9c9c9; padding:3px 6px; }
            table.rs-info td.lbl { background:#eef1f5; font-weight:bold; width:18%; color:#2f3a48; }

            table.rs-table { width:100%; border-collapse:collapse; margin:4px 0; }
            table.rs-table th { background:#2f3a48; color:#fff; border:1px solid #26303b;
                                padding:4px 5px; font-size:10px; }
            table.rs-table td { border:1px solid #c9c9c9; padding:3px 5px; font-size:10px; }
            table.rs-table tr:nth-child(even) td { background:#f6f8fa; }

            .rs-pill { display:inline-block; padding:1px 8px; border-radius:10px; font-size:9px; color:#fff; }
            .rs-ok { background:#2e7d32; }
            .rs-no { background:#c62828; }
            .rs-na { background:#9e9e9e; }
            .rs-chk { display:inline-block; margin:1px 12px 1px 0; font-size:10px; }
            .rs-note { border:1px solid #c9c9c9; padding:5px 7px; min-height:26px; margin-bottom:4px;
                       white-space:pre-line; }

            table.rs-sign { width:100%; border-collapse:collapse; margin-top:12px; }
            table.rs-sign td { border:1px solid #2f3a48; width:33.33%; padding:5px 8px;
                               vertical-align:top; height:70px; }
            .rs-sign .role { font-weight:bold; color:#2f3a48; border-bottom:1px solid #c2a24a;
                             padding-bottom:2px; margin-bottom:4px; }
            .rs-sign img { max-height:34px; max-width:90%; }
        </style>
    </template>

    <!-- شريط قسم مرقّم ثنائي اللغة -->
    <template id="rs_section">
        <div class="rs-secbar">
            <span><t t-out="sec_no"/>. <t t-out="sec_ar"/></span>
            <span class="rs-sec-en"><t t-out="sec_en"/></span>
        </div>
    </template>

    <!-- التخطيط الكامل لهوية رواسي سما -->
    <template id="rawasi_layout">
        <div class="page rs-doc">
            <t t-call="simple_manufacturing.rawasi_style"/>
            <div class="rs-header">
                <div class="rs-code">
                    <div t-out="doc_code"/>
                    <div class="rs-rev">ED.1 / REV.0</div>
                </div>
                <div class="rs-center">
                    <div class="rs-docno"><t t-out="o.name"/></div>
                    <div class="rs-title"><t t-out="doc_title"/></div>
                    <div class="rs-title-en"><t t-out="doc_title_en"/></div>
                </div>
                <div class="rs-co">
                    رواسي سما للمقاولات
                    <div class="rs-co-en">RAWASI SAMA CONTRACTING</div>
                </div>
            </div>
            <div class="rs-goldbar"/>
            <t t-out="0"/>
            <div class="rs-footer">
                رواسي سما للمقاولات · RAWASI SAMA CONTRACTING — <t t-out="o.name"/>
            </div>
        </div>
    </template>

</odoo>
