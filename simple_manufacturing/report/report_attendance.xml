<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_attendance_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="simple_manufacturing.rawasi_layout">
                    <t t-set="doc_code">RS-WS-07</t>
                    <t t-set="doc_title">كشف حضور وانصراف العمالة</t>
                    <t t-set="doc_title_en">Attendance Sheet</t>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">1</t><t t-set="sec_ar">البيانات</t><t t-set="sec_en">Data</t>
                    </t>
                    <table class="rs-info">
                        <tr>
                            <td class="lbl">التاريخ</td><td><span t-field="o.date"/></td>
                            <td class="lbl">الورشة</td><td t-out="o.workshop or ''"/>
                        </tr>
                        <tr>
                            <td class="lbl">الوردية</td><td><span t-field="o.shift"/></td>
                            <td class="lbl">إجمالي الحضور</td><td t-out="o.total_present"/>
                        </tr>
                    </table>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">2</t><t t-set="sec_ar">كشف الحضور</t><t t-set="sec_en">Attendance</t>
                    </t>
                    <table class="rs-table">
                        <tr><th style="width:6%">م.</th><th style="width:14%">البصمة</th><th>اسم العامل</th>
                            <th style="width:14%">المهنة</th><th style="width:10%">دخول</th><th style="width:10%">خروج</th>
                            <th style="width:10%">إضافي</th><th style="width:10%">إجمالي</th></tr>
                        <tr t-foreach="o.line_ids" t-as="l">
                            <td t-out="l_index + 1"/><td t-out="l.badge_id or ''"/><td t-out="l.worker_name or ''"/>
                            <td t-out="l.trade or ''"/><td t-out="l.time_in or ''"/><td t-out="l.time_out or ''"/>
                            <td t-out="l.overtime"/><td t-out="l.total_hours"/>
                        </tr>
                    </table>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_attendance" model="ir.actions.report">
        <field name="name">كشف الحضور</field>
        <field name="model">simple.mrp.attendance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">simple_manufacturing.report_attendance_document</field>
        <field name="report_file">simple_manufacturing.report_attendance_document</field>
        <field name="binding_model_id" ref="model_simple_mrp_attendance"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_simple_mrp"/>
    </record>

</odoo>
