<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_toolbox_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="simple_manufacturing.rawasi_layout">
                    <t t-set="doc_code">RS-WS-18</t>
                    <t t-set="doc_title">اجتماع السلامة اليومي</t>
                    <t t-set="doc_title_en">Toolbox Talk</t>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">1</t><t t-set="sec_ar">البيانات</t><t t-set="sec_en">Data</t>
                    </t>
                    <table class="rs-info">
                        <tr>
                            <td class="lbl">التاريخ</td><td><span t-field="o.date"/></td>
                            <td class="lbl">الورشة</td><td t-out="o.workshop or ''"/>
                        </tr>
                        <tr>
                            <td class="lbl">الموضوع</td><td t-out="o.topic or ''"/>
                            <td class="lbl">المُلقي</td><td t-out="o.presenter or ''"/>
                        </tr>
                    </table>
                    <div class="rs-note" t-out="o.key_points or ''"/>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">2</t><t t-set="sec_ar">المخاطر</t><t t-set="sec_en">Hazards</t>
                    </t>
                    <div>
                        <span class="rs-chk"><t t-out="'☑' if o.hz_cuts else '☐'"/> القطع والجروح</span>
                        <span class="rs-chk"><t t-out="'☑' if o.hz_fall else '☐'"/> السقوط</span>
                        <span class="rs-chk"><t t-out="'☑' if o.hz_electrical else '☐'"/> الكهرباء</span>
                        <span class="rs-chk"><t t-out="'☑' if o.hz_fire else '☐'"/> الحريق</span>
                        <span class="rs-chk"><t t-out="'☑' if o.hz_lifting else '☐'"/> الأحمال</span>
                        <span class="rs-chk"><t t-out="'☑' if o.hz_heat else '☐'"/> الحرارة</span>
                        <span class="rs-chk"><t t-out="'☑' if o.hz_chemicals else '☐'"/> الكيماويات</span>
                        <span class="rs-chk"><t t-out="'☑' if o.hz_noise else '☐'"/> الضوضاء</span>
                    </div>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">3</t><t t-set="sec_ar">الحضور</t><t t-set="sec_en">Attendees</t>
                    </t>
                    <table class="rs-table">
                        <tr><th style="width:8%">م.</th><th>الاسم</th><th style="width:20%">البصمة</th><th style="width:20%">المهنة</th></tr>
                        <tr t-foreach="o.line_ids" t-as="l">
                            <td t-out="l_index + 1"/><td t-out="l.worker_name or ''"/><td t-out="l.badge_id or ''"/><td t-out="l.trade or ''"/>
                        </tr>
                    </table>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_toolbox" model="ir.actions.report">
        <field name="name">اجتماع السلامة</field>
        <field name="model">simple.mrp.toolbox</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">simple_manufacturing.report_toolbox_document</field>
        <field name="report_file">simple_manufacturing.report_toolbox_document</field>
        <field name="binding_model_id" ref="model_simple_mrp_toolbox"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_simple_mrp"/>
    </record>

</odoo>
