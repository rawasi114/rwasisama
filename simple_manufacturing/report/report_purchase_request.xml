<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_purchase_request_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="simple_manufacturing.rawasi_layout">
                    <t t-set="doc_code">RS-WS-PR</t>
                    <t t-set="doc_title">طلب شراء</t>
                    <t t-set="doc_title_en">Purchase Request</t>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">1</t><t t-set="sec_ar">بيانات الطلب</t><t t-set="sec_en">Request Data</t>
                    </t>
                    <table class="rs-info">
                        <tr>
                            <td class="lbl">المورّد</td><td t-out="o.vendor_id.name or ''"/>
                            <td class="lbl">أمر التصنيع</td><td t-out="o.order_id.name or ''"/>
                        </tr>
                        <tr>
                            <td class="lbl">تاريخ الطلب</td><td><span t-field="o.date_order"/></td>
                            <td class="lbl">رقم أمر الشراء</td><td t-out="o.po_number or ''"/>
                        </tr>
                    </table>
                    <t t-call="simple_manufacturing.rs_section">
                        <t t-set="sec_no">2</t><t t-set="sec_ar">البنود</t><t t-set="sec_en">Lines</t>
                    </t>
                    <table class="rs-table">
                        <tr><th style="width:6%">م.</th><th>المنتج</th><th style="width:12%">الكمية</th>
                            <th style="width:12%">سعر الوحدة</th><th style="width:14%">الإجمالي</th>
                            <th style="width:12%">المستلم</th><th style="width:12%">المطابقة</th></tr>
                        <tr t-foreach="o.line_ids" t-as="l">
                            <td t-out="l_index + 1"/><td t-out="l.product_id.display_name or ''"/>
                            <td t-out="l.qty"/><td t-out="l.unit_cost"/><td t-out="l.amount"/>
                            <td t-out="l.qty_received"/><td><span t-field="l.conformance"/></td>
                        </tr>
                    </table>
                    <table class="rs-info">
                        <tr><td class="lbl">الإجمالي</td><td colspan="3" t-out="o.amount_total"/></tr>
                    </table>
                    <table class="rs-sign">
                        <tr>
                            <td><div class="role">طالب الشراء</div></td>
                            <td><div class="role">المعتمِد</div></td>
                            <td><div class="role">المستلم</div></td>
                        </tr>
                    </table>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_purchase_request" model="ir.actions.report">
        <field name="name">طلب شراء</field>
        <field name="model">simple.mrp.purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">simple_manufacturing.report_purchase_request_document</field>
        <field name="report_file">simple_manufacturing.report_purchase_request_document</field>
        <field name="binding_model_id" ref="model_simple_mrp_purchase_request"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_simple_mrp"/>
    </record>

</odoo>
