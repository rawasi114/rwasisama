<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_simple_mrp" model="ir.module.category">
            <field name="name">إدارة الورشة</field>
            <field name="description">صلاحيات نظام إدارة ورشة المقاولات</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_simple_mrp_user" model="res.groups">
            <field name="name">موظف الورشة</field>
            <field name="category_id" ref="module_category_simple_mrp"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_simple_mrp_manager" model="res.groups">
            <field name="name">مدير الورشة</field>
            <field name="category_id" ref="module_category_simple_mrp"/>
            <field name="implied_ids" eval="[(4, ref('group_simple_mrp_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
