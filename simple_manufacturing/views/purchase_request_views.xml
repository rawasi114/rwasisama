<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_simple_mrp_pr_list" model="ir.ui.view">
        <field name="name">simple.mrp.purchase.request.list</field>
        <field name="model">simple.mrp.purchase.request</field>
        <field name="arch" type="xml">
            <list string="طلبات الشراء" create="0"
                  decoration-success="state == 'received'" decoration-info="state == 'partial'"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="order_id"/>
                <field name="date_order"/>
                <field name="amount_total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_simple_mrp_pr_form" model="ir.ui.view">
        <field name="name">simple.mrp.purchase.request.form</field>
        <field name="model">simple.mrp.purchase.request</field>
        <field name="arch" type="xml">
            <form string="طلب شراء" create="0">
                <header>
                    <button name="action_confirm" string="تأكيد" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_receive" string="استلام" type="object" class="btn-primary"
                            invisible="state not in ('confirmed','partial')"/>
                    <button name="action_cancel" string="إلغاء" type="object"
                            invisible="state in ('received','partial','cancel')"/>
                    <button name="action_draft" string="إلى مسودة" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,partial,received"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="order_id"/>
                            <field name="origin"/>
                        </group>
                        <group>
                            <field name="date_order"/>
                            <field name="date_received" readonly="1"/>
                            <field name="po_number"/>
                            <field name="invoice_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="البنود" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="unit_cost"/>
                                    <field name="amount" readonly="1"/>
                                    <field name="qty_received" readonly="1"/>
                                    <field name="received_qty"/>
                                    <field name="conformance"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_pr" model="ir.actions.act_window">
        <field name="name">طلبات الشراء</field>
        <field name="res_model">simple.mrp.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
