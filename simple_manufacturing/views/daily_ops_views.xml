<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- التحضير اليومي -->
    <record id="view_simple_mrp_dp_list" model="ir.ui.view">
        <field name="name">simple.mrp.daily.prep.list</field>
        <field name="model">simple.mrp.daily.prep</field>
        <field name="arch" type="xml">
            <list string="التحضير اليومي" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="workshop"/>
                <field name="shift_supervisor"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_simple_mrp_dp_form" model="ir.ui.view">
        <field name="name">simple.mrp.daily.prep.form</field>
        <field name="model">simple.mrp.daily.prep</field>
        <field name="arch" type="xml">
            <form string="التحضير اليومي">
                <header>
                    <button name="action_done" string="إنهاء" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" string="إلى مسودة" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="workshop"/>
                            <field name="shift_supervisor"/>
                            <field name="available_crew"/>
                            <field name="absent_crew"/>
                        </group>
                        <group>
                            <field name="ready_equipment"/>
                            <field name="maintenance_equipment"/>
                            <field name="materials_ready"/>
                            <field name="drawings_approved"/>
                            <field name="toolbox_done"/>
                            <field name="ppe_verified"/>
                            <field name="targets_reviewed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الأعمال المخططة" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="wo_ref"/>
                                    <field name="task"/>
                                    <field name="assigned_to"/>
                                    <field name="hours"/>
                                    <field name="expected_output"/>
                                </list>
                            </field>
                        </page>
                        <page string="المعوقات" name="bottlenecks">
                            <field name="bottlenecks"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_dp" model="ir.actions.act_window">
        <field name="name">التحضير اليومي</field>
        <field name="res_model">simple.mrp.daily.prep</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- التقرير اليومي -->
    <record id="view_simple_mrp_dr_list" model="ir.ui.view">
        <field name="name">simple.mrp.daily.report.list</field>
        <field name="model">simple.mrp.daily.report</field>
        <field name="arch" type="xml">
            <list string="التقرير اليومي" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="workshop"/>
                <field name="crew_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_simple_mrp_dr_form" model="ir.ui.view">
        <field name="name">simple.mrp.daily.report.form</field>
        <field name="model">simple.mrp.daily.report</field>
        <field name="arch" type="xml">
            <form string="التقرير اليومي">
                <header>
                    <button name="action_done" string="إنهاء" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" string="إلى مسودة" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="workshop"/>
                            <field name="weather"/>
                            <field name="working_hours"/>
                        </group>
                        <group>
                            <field name="crew_count"/>
                            <field name="man_hours"/>
                            <field name="equipment_used"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الإنجازات" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="wo_ref"/>
                                    <field name="description"/>
                                    <field name="planned"/>
                                    <field name="done"/>
                                    <field name="completion" readonly="1"/>
                                    <field name="remaining" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="المعوقات وخطة الغد" name="issues">
                            <group>
                                <field name="issues"/>
                                <field name="plan_tomorrow"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_dr" model="ir.actions.act_window">
        <field name="name">التقرير اليومي</field>
        <field name="res_model">simple.mrp.daily.report</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
