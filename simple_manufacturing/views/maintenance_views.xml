<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_simple_mrp_mnt_list" model="ir.ui.view">
        <field name="name">simple.mrp.maintenance.list</field>
        <field name="model">simple.mrp.maintenance</field>
        <field name="arch" type="xml">
            <list string="سجلات الصيانة">
                <field name="name"/>
                <field name="machine"/>
                <field name="asset_no"/>
                <field name="location"/>
                <field name="frequency"/>
            </list>
        </field>
    </record>

    <record id="view_simple_mrp_mnt_form" model="ir.ui.view">
        <field name="name">simple.mrp.maintenance.form</field>
        <field name="model">simple.mrp.maintenance</field>
        <field name="arch" type="xml">
            <form string="سجل صيانة">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="machine"/>
                            <field name="asset_no"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="year"/>
                            <field name="frequency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="أعمال الصيانة" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="work_type"/>
                                    <field name="work"/>
                                    <field name="spares"/>
                                    <field name="downtime"/>
                                    <field name="technician"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_mnt" model="ir.actions.act_window">
        <field name="name">سجلات الصيانة</field>
        <field name="res_model">simple.mrp.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
