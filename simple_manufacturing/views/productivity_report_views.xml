<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_simple_mrp_productivity_form" model="ir.ui.view">
        <field name="name">simple.mrp.productivity.report.form</field>
        <field name="model">simple.mrp.productivity.report</field>
        <field name="arch" type="xml">
            <form string="تقرير الإنتاجية">
                <group>
                    <group>
                        <field name="report_type"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <button name="get_report_data" string="احتساب" type="object" class="btn-primary"/>
                <field name="line_ids" readonly="1">
                    <list string="النتائج">
                        <field name="product_id"/>
                        <field name="order_count"/>
                        <field name="total_qty"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_productivity" model="ir.actions.act_window">
        <field name="name">تقرير الإنتاجية</field>
        <field name="res_model">simple.mrp.productivity.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
