<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_simple_mrp_qc_list" model="ir.ui.view">
        <field name="name">simple.mrp.quality.check.list</field>
        <field name="model">simple.mrp.quality.check</field>
        <field name="arch" type="xml">
            <list string="فحوص الجودة" decoration-success="state == 'pass'" decoration-danger="state == 'fail'">
                <field name="name"/>
                <field name="date"/>
                <field name="product_id"/>
                <field name="order_id"/>
                <field name="pass_rate"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_simple_mrp_qc_form" model="ir.ui.view">
        <field name="name">simple.mrp.quality.check.form</field>
        <field name="model">simple.mrp.quality.check</field>
        <field name="arch" type="xml">
            <form string="فحص جودة">
                <header>
                    <button name="action_pass" string="ناجح" type="object" class="btn-primary"
                            invisible="state == 'pass'"/>
                    <button name="action_fail" string="راسب" type="object"
                            invisible="state == 'fail'"/>
                    <button name="action_draft" string="إلى مسودة" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="inspector_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="order_id"/>
                            <field name="quantity"/>
                            <field name="pass_rate" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="بنود الفحص" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="result"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_qc" model="ir.actions.act_window">
        <field name="name">فحوص الجودة</field>
        <field name="res_model">simple.mrp.quality.check</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
