<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_simple_mrp_mr_list" model="ir.ui.view">
        <field name="name">simple.mrp.material.request.list</field>
        <field name="model">simple.mrp.material.request</field>
        <field name="arch" type="xml">
            <list string="طلبات المواد" decoration-success="state == 'issued'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department"/>
                <field name="date"/>
                <field name="order_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_simple_mrp_mr_form" model="ir.ui.view">
        <field name="name">simple.mrp.material.request.form</field>
        <field name="model">simple.mrp.material.request</field>
        <field name="arch" type="xml">
            <form string="طلب مواد">
                <header>
                    <button name="action_approve" string="اعتماد" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_issue" string="صرف" type="object" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_cancel" string="إلغاء" type="object"
                            invisible="state in ('issued','cancel')"/>
                    <button name="action_draft" string="إلى مسودة" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,issued"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="requester_id"/>
                            <field name="department"/>
                            <field name="date"/>
                            <field name="order_id"/>
                            <field name="project"/>
                        </group>
                        <group>
                            <field name="cost_center"/>
                            <field name="job_no"/>
                            <field name="boq_item"/>
                            <field name="receiver_id"/>
                            <field name="date_issued" readonly="1"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="سبب الطلب..."/>
                    <notebook>
                        <page string="البنود" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="available_qty" readonly="1"/>
                                    <field name="returned_qty"/>
                                    <field name="net_qty" readonly="1"/>
                                    <field name="purpose"/>
                                    <field name="bin_card"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_mr" model="ir.actions.act_window">
        <field name="name">طلبات المواد</field>
        <field name="res_model">simple.mrp.material.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
