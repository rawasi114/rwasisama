<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_simple_mrp_tbt_list" model="ir.ui.view">
        <field name="name">simple.mrp.toolbox.list</field>
        <field name="model">simple.mrp.toolbox</field>
        <field name="arch" type="xml">
            <list string="اجتماعات السلامة">
                <field name="name"/>
                <field name="date"/>
                <field name="workshop"/>
                <field name="topic"/>
                <field name="presenter"/>
            </list>
        </field>
    </record>

    <record id="view_simple_mrp_tbt_form" model="ir.ui.view">
        <field name="name">simple.mrp.toolbox.form</field>
        <field name="model">simple.mrp.toolbox</field>
        <field name="arch" type="xml">
            <form string="اجتماع سلامة">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="workshop"/>
                            <field name="topic"/>
                            <field name="presenter"/>
                        </group>
                        <group string="المخاطر">
                            <field name="hz_cuts"/>
                            <field name="hz_fall"/>
                            <field name="hz_electrical"/>
                            <field name="hz_fire"/>
                            <field name="hz_lifting"/>
                            <field name="hz_heat"/>
                            <field name="hz_chemicals"/>
                            <field name="hz_noise"/>
                        </group>
                    </group>
                    <field name="key_points" placeholder="النقاط الرئيسية..."/>
                    <notebook>
                        <page string="الحضور" name="attendees">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="worker_name"/>
                                    <field name="badge_id"/>
                                    <field name="trade"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_tbt" model="ir.actions.act_window">
        <field name="name">اجتماعات السلامة</field>
        <field name="res_model">simple.mrp.toolbox</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
