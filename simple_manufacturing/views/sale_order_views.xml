<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_workshop_mo" model="ir.ui.view">
        <field name="name">sale.order.form.workshop.mo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="workshop_mo_enabled" invisible="1"/>
                <button name="action_view_workshop_mos" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="workshop_mo_count == 0">
                    <field name="workshop_mo_count" widget="statinfo" string="أوامر التصنيع"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_workshop_mos" type="object" string="إنشاء أوامر التصنيع"
                        invisible="state != 'sale' or not workshop_mo_enabled"/>
            </xpath>
        </field>
    </record>

</odoo>
