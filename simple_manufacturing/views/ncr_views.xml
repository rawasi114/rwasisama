<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_simple_mrp_ncr_list" model="ir.ui.view">
        <field name="name">simple.mrp.ncr.list</field>
        <field name="model">simple.mrp.ncr</field>
        <field name="arch" type="xml">
            <list string="عدم المطابقة" decoration-danger="state == 'open'" decoration-success="state == 'closed'"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="project"/>
                <field name="item"/>
                <field name="severity"/>
                <field name="detected_on"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_simple_mrp_ncr_form" model="ir.ui.view">
        <field name="name">simple.mrp.ncr.form</field>
        <field name="model">simple.mrp.ncr</field>
        <field name="arch" type="xml">
            <form string="تقرير عدم مطابقة">
                <header>
                    <button name="action_close" string="إغلاق" type="object" class="btn-primary"
                            invisible="state != 'open'"/>
                    <button name="action_reopen" string="إعادة فتح" type="object"
                            invisible="state != 'closed'"/>
                    <button name="action_cancel" string="إلغاء" type="object"
                            invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project"/>
                            <field name="item"/>
                            <field name="detected_on"/>
                        </group>
                        <group>
                            <field name="severity"/>
                            <field name="repeated"/>
                            <field name="raised_by"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="root_cause"/>
                    </group>
                    <notebook>
                        <page string="الإجراءات التصحيحية" name="actions">
                            <field name="action_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="owner"/>
                                    <field name="due_date"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_ncr" model="ir.actions.act_window">
        <field name="name">عدم المطابقة</field>
        <field name="res_model">simple.mrp.ncr</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
