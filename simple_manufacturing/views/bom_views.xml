<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_simple_mrp_bom_list" model="ir.ui.view">
        <field name="name">simple.mrp.bom.list</field>
        <field name="model">simple.mrp.bom</field>
        <field name="arch" type="xml">
            <list string="قوائم المواد">
                <field name="code"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="uom_name"/>
                <field name="component_count"/>
            </list>
        </field>
    </record>

    <record id="view_simple_mrp_bom_form" model="ir.ui.view">
        <field name="name">simple.mrp.bom.form</field>
        <field name="model">simple.mrp.bom</field>
        <field name="arch" type="xml">
            <form string="قائمة مواد">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="uom_name"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="المكوّنات" name="components">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="component_id"/>
                                    <field name="qty"/>
                                    <field name="available_qty" readonly="1"/>
                                    <field name="uom_name"/>
                                </list>
                            </field>
                        </page>
                        <page string="ملاحظات" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_bom" model="ir.actions.act_window">
        <field name="name">قوائم المواد</field>
        <field name="res_model">simple.mrp.bom</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
