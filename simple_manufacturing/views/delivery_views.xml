<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_simple_mrp_do_list" model="ir.ui.view">
        <field name="name">simple.mrp.delivery.list</field>
        <field name="model">simple.mrp.delivery</field>
        <field name="arch" type="xml">
            <list string="التسليمات" create="0"
                  decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <field name="scheduled_date"/>
                <field name="amount_total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_simple_mrp_do_form" model="ir.ui.view">
        <field name="name">simple.mrp.delivery.form</field>
        <field name="model">simple.mrp.delivery</field>
        <field name="arch" type="xml">
            <form string="أمر تسليم" create="0">
                <header>
                    <button name="action_validate" string="تأكيد التسليم" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" string="إلغاء" type="object"
                            invisible="state in ('done','cancel')"/>
                    <button name="action_draft" string="إلى مسودة" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="delivery_address"/>
                            <field name="order_id"/>
                            <field name="origin"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="date_done" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="البنود" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" decoration-danger="available_qty &lt; qty">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="available_qty" readonly="1"/>
                                    <field name="unit_price"/>
                                    <field name="amount" readonly="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="التوقيع" name="sign">
                            <group>
                                <field name="customer_sign_name"/>
                                <field name="customer_signature" widget="finger_signature"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_do" model="ir.actions.act_window">
        <field name="name">التسليمات</field>
        <field name="res_model">simple.mrp.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
