<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_simple_mrp_job_list" model="ir.ui.view">
        <field name="name">simple.mrp.job.order.list</field>
        <field name="model">simple.mrp.job.order</field>
        <field name="arch" type="xml">
            <list string="أوامر الشغل" decoration-info="state == 'progress'" decoration-success="state == 'done'"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="workshop_type"/>
                <field name="project"/>
                <field name="order_id"/>
                <field name="due_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_simple_mrp_job_form" model="ir.ui.view">
        <field name="name">simple.mrp.job.order.form</field>
        <field name="model">simple.mrp.job.order</field>
        <field name="arch" type="xml">
            <form string="أمر شغل">
                <header>
                    <button name="action_start" string="بدء" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done" string="إنهاء" type="object" class="btn-primary"
                            invisible="state != 'progress'"/>
                    <button name="action_cancel" string="إلغاء" type="object"
                            invisible="state in ('done','cancel')"/>
                    <button name="action_draft" string="إلى مسودة" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="workshop_type"/>
                            <field name="project"/>
                            <field name="order_id"/>
                            <field name="wo_ref"/>
                            <field name="approved_dwg"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="element"/>
                            <field name="material"/>
                            <field name="thickness"/>
                            <field name="dimensions"/>
                            <field name="qty"/>
                            <field name="finish"/>
                        </group>
                    </group>
                    <field name="spec_notes" placeholder="مواصفات / ملاحظات..."/>
                    <notebook>
                        <page string="المراحل" name="stages">
                            <field name="stage_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="responsible"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_simple_mrp_job" model="ir.actions.act_window">
        <field name="name">أوامر الشغل</field>
        <field name="res_model">simple.mrp.job.order</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
