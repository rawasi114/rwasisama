<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rps_boq_import_wizard_form" model="ir.ui.view">
        <field name="name">rps.boq.import.wizard.form</field>
        <field name="model">rps.boq.import.wizard</field>
        <field name="arch" type="xml">
            <form string="رفع جدول الكميات">
                <sheet>
                    <div class="oe_title">
                        <h2>📊 رفع جدول الكميات (BoQ Import)</h2>
                        <p>ارفع جدول الكميات لتغذية محرك التسعير المرجعي.</p>
                    </div>

                    <group invisible="state != 'draft'">
                        <group string="بيانات الرفع">
                            <field name="tender_id" required="1"/>
                            <field name="boq_type" required="1"
                                   widget="radio"
                                   options="{'horizontal': false}"/>
                            <field name="source_competitor_id"
                                   invisible="boq_type != 'competitor'"
                                   required="boq_type == 'competitor'"/>
                            <field name="upload_file"
                                   filename="upload_filename"
                                   required="1"/>
                            <field name="upload_filename" invisible="1"/>
                        </group>
                        <group string="الصيغ المدعومة">
                            <div colspan="2">
                                <ul>
                                    <li>Excel: <code>.xlsx</code>, <code>.xls</code></li>
                                    <li>CSV: <code>.csv</code></li>
                                    <li>PDF: <code>.pdf</code> (معالجة بـ Claude AI)</li>
                                </ul>
                                <p class="text-muted">
                                    الحد الأقصى لحجم الملف: 10 ميجابايت.
                                </p>
                            </div>
                        </group>
                    </group>

                    <group invisible="state != 'preview'">
                        <group string="نتيجة الاستخراج">
                            <field name="total_items" readonly="1"/>
                            <field name="items_needing_review" readonly="1"/>
                            <field name="source_file_id" readonly="1"/>
                        </group>
                        <div colspan="2" class="alert alert-info" role="alert">
                            <strong>📋 جاهز للحفظ:</strong>
                            تم استخراج البنود وتطبيعها. اضغط "حفظ البنود"
                            للحفظ النهائي، أو "تعديل" للعودة وتغيير الملف.
                        </div>
                    </group>

                    <group invisible="state != 'done'">
                        <div class="alert alert-success" role="alert">
                            <strong>✅ تم بنجاح:</strong> حُفظت بنود جدول الكميات
                            وتم تحديث محرك التسعير المرجعي تلقائياً.
                        </div>
                    </group>
                </sheet>
                <footer>
                    <button string="رفع وتحليل"
                            name="action_upload"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="💾 حفظ البنود"
                            name="action_confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'preview'"/>
                    <button string="↺ تعديل"
                            name="action_back_to_edit"
                            type="object"
                            invisible="state != 'preview'"/>
                    <button string="إغلاق"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rps_boq_import_wizard" model="ir.actions.act_window">
        <field name="name">رفع جدول الكميات</field>
        <field name="res_model">rps.boq.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_rps_tender"/>
        <field name="binding_view_types">form,list</field>
    </record>

    <menuitem id="menu_rps_boq_import"
              name="📊 رفع جدول كميات"
              parent="menu_rps_tenders"
              action="action_rps_boq_import_wizard"
              sequence="20"/>
</odoo>
