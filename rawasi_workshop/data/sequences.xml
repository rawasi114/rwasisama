<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_rawasi_workshop_mo" model="ir.sequence">
            <field name="name">أمر تصنيع ورشة</field>
            <field name="code">rawasi.workshop.mo</field>
            <field name="prefix">WMO-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_rawasi_workshop_mr" model="ir.sequence">
            <field name="name">طلب مواد ورشة</field>
            <field name="code">rawasi.workshop.material.request</field>
            <field name="prefix">WMR-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
