<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- حسابات تحليلية للأقسام ضمن خطة «أقسام الورشة» -->
        <record id="analytic_carp" model="account.analytic.account">
            <field name="name">النجارة</field>
            <field name="plan_id" ref="rawasi_base.analytic_plan_workshop"/>
        </record>
        <record id="analytic_steel" model="account.analytic.account">
            <field name="name">الحدادة</field>
            <field name="plan_id" ref="rawasi_base.analytic_plan_workshop"/>
        </record>

        <!-- الأقسام الافتراضية -->
        <record id="section_carp" model="rawasi.workshop.section">
            <field name="name">النجارة</field>
            <field name="code">CARP</field>
            <field name="analytic_account_id" ref="analytic_carp"/>
        </record>
        <record id="section_steel" model="rawasi.workshop.section">
            <field name="name">الحدادة</field>
            <field name="code">STEEL</field>
            <field name="analytic_account_id" ref="analytic_steel"/>
        </record>

    </data>
</odoo>
