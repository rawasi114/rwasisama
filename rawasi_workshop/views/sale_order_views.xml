<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- زر أوامر التصنيع على أمر البيع -->
        <record id="view_order_form_rawasi_workshop" model="ir.ui.view">
            <field name="name">sale.order.form.rawasi.workshop</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_workshop_mos" type="object"
                            class="oe_stat_button" icon="fa-wrench"
                            invisible="workshop_mo_count == 0">
                        <field name="workshop_mo_count" widget="statinfo" string="أوامر التصنيع"/>
                    </button>
                </div>
            </field>
        </record>

        <!-- علامة «يُصنَّع في الورشة» على المنتج -->
        <record id="view_product_template_form_rawasi_workshop" model="ir.ui.view">
            <field name="name">product.template.form.rawasi.workshop</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <field name="sale_ok" position="after">
                    <field name="rawasi_produce_in_workshop"/>
                    <field name="rawasi_workshop_section_id"
                           invisible="not rawasi_produce_in_workshop"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
