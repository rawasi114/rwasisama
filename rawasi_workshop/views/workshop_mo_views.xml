<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_workshop_mo_list" model="ir.ui.view">
            <field name="name">rawasi.workshop.mo.list</field>
            <field name="model">rawasi.workshop.mo</field>
            <field name="arch" type="xml">
                <list string="أوامر التصنيع" decoration-success="state == 'delivered'"
                      decoration-info="state == 'in_production'"
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="section_id"/>
                    <field name="partner_id"/>
                    <field name="amount_total"/>
                    <field name="deposit_pct" widget="percentage"/>
                    <field name="is_internal"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'delivered'"
                           decoration-info="state == 'in_production'"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_workshop_mo_kanban" model="ir.ui.view">
            <field name="name">rawasi.workshop.mo.kanban</field>
            <field name="model">rawasi.workshop.mo</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="section_id"/>
                    <field name="partner_id"/>
                    <field name="deposit_pct"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div><field name="section_id"/></div>
                                <div><field name="partner_id"/></div>
                                <div>سداد: <field name="deposit_pct"/>%</div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_workshop_mo_form" model="ir.ui.view">
            <field name="name">rawasi.workshop.mo.form</field>
            <field name="model">rawasi.workshop.mo</field>
            <field name="arch" type="xml">
                <form string="أمر تصنيع">
                    <header>
                        <button name="action_confirm" type="object" string="تأكيد"
                                class="btn-primary" invisible="state != 'draft'"
                                groups="group_supervisor,rawasi_base.group_rawasi_admin"/>
                        <button name="action_start_production" type="object" string="بدء التصنيع"
                                class="btn-primary" invisible="state != 'confirmed'"/>
                        <button name="action_done" type="object" string="اكتمال التصنيع"
                                class="btn-primary" invisible="state != 'in_production'"/>
                        <button name="action_deliver" type="object" string="تسليم"
                                class="btn-primary" invisible="state != 'done'"/>
                        <button name="action_cancel" type="object" string="إلغاء"
                                invisible="state in ('delivered','cancelled')"/>
                        <button name="action_reset_draft" type="object" string="إعادة لمسودة"
                                invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,in_production,done,delivered"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                        <group>
                            <group>
                                <field name="section_id"/>
                                <field name="partner_id"/>
                                <field name="sale_order_id"/>
                                <field name="is_internal"/>
                            </group>
                            <group>
                                <field name="date_order"/>
                                <field name="date_deadline"/>
                                <field name="amount_received"/>
                                <field name="deposit_pct" widget="percentage"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="no_payment_required" invisible="1"/>
                                <field name="can_start_production" invisible="1"/>
                                <field name="can_start_delivery" invisible="1"/>
                            </group>
                        </group>
                        <div class="alert alert-warning" role="alert"
                             invisible="can_start_production or state != 'confirmed'">
                            بدء التصنيع يتطلب سداد دفعة 50% على الأقل.
                        </div>
                        <div class="alert alert-warning" role="alert"
                             invisible="can_start_delivery or state != 'done'">
                            التسليم يتطلب سداد كامل القيمة (100%).
                        </div>
                        <notebook>
                            <page string="المنتجات">
                                <field name="product_line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="product_id"/>
                                        <field name="description"/>
                                        <field name="qty"/>
                                        <field name="qty_produced"/>
                                        <field name="uom_id"/>
                                        <field name="unit_price"/>
                                        <field name="subtotal"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer">
                                    <field name="amount_total"/>
                                </group>
                            </page>
                            <page string="ملاحظات">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_workshop_mo" model="ir.actions.act_window">
            <field name="name">أوامر التصنيع</field>
            <field name="res_model">rawasi.workshop.mo</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <menuitem id="menu_workshop_operations" name="العمليات"
                  parent="menu_workshop_root" sequence="10"/>
        <menuitem id="menu_workshop_mo" name="أوامر التصنيع"
                  parent="menu_workshop_operations" action="action_workshop_mo" sequence="10"/>

    </data>
</odoo>
