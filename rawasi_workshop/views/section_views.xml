<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_section_list" model="ir.ui.view">
            <field name="name">rawasi.workshop.section.list</field>
            <field name="model">rawasi.workshop.section</field>
            <field name="arch" type="xml">
                <list string="أقسام الورشة">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="responsible_user_id"/>
                    <field name="analytic_account_id"/>
                </list>
            </field>
        </record>

        <record id="view_section_form" model="ir.ui.view">
            <field name="name">rawasi.workshop.section.form</field>
            <field name="model">rawasi.workshop.section</field>
            <field name="arch" type="xml">
                <form string="قسم ورشة">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="اسم القسم"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="responsible_user_id"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="analytic_account_id"/>
                                <field name="stock_location_id"/>
                                <field name="production_location_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_section" model="ir.actions.act_window">
            <field name="name">أقسام الورشة</field>
            <field name="res_model">rawasi.workshop.section</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_workshop_config" name="الإعداد"
                  parent="menu_workshop_root" sequence="90"
                  groups="group_supervisor,rawasi_base.group_rawasi_admin"/>
        <menuitem id="menu_section" name="الأقسام"
                  parent="menu_workshop_config" action="action_section" sequence="10"/>

    </data>
</odoo>
