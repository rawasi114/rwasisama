<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- مجموعات موديول الورشة (ضمن فئة «رواسي» من rawasi_base) -->

        <record id="group_worker" model="res.groups">
            <field name="name">عامل/فني ورشة</field>
            <field name="category_id" ref="rawasi_base.module_category_rawasi"/>
        </record>

        <record id="group_supervisor" model="res.groups">
            <field name="name">مشرف ورشة</field>
            <field name="category_id" ref="rawasi_base.module_category_rawasi"/>
            <field name="implied_ids" eval="[(4, ref('group_worker'))]"/>
        </record>

        <!-- أدمن رواسي يحصل تلقائياً على أدوار الورشة -->
        <record id="rawasi_base.group_rawasi_admin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_supervisor'))]"/>
        </record>

    </data>
</odoo>
