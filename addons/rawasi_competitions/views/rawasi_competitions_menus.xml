<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            النسخة السابقة من هذا الموديول أنشأت تطبيقاً واجهياً باسم
            "المنافسات والتسعير". الفصل الجديد أصبح معرفاً داخل
            rawasi_construction حتى يتم تحميله بترتيب ترقية آمن.

            نُبقي هذين السجلين هنا فقط لإخفاء الجذر القديم عند ترقية
            rawasi_competitions في قواعد كانت قد ثبّتت النسخة السابقة.
        -->
        <record id="menu_rawasi_competitions_root" model="ir.ui.menu">
            <field name="name">المنافسات والتسعير - قديم</field>
            <field name="active" eval="False"/>
        </record>

        <record id="menu_competitions_pricing_root_dashboard" model="ir.ui.menu">
            <field name="name">تحليل المنافسات - قديم</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
