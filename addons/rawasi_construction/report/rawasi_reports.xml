                        <h2 class="text-center">طلب مواد</h2>
                        <h4 class="text-center"><span t-field="o.name"/></h4>
                        <table class="table table-sm">
                            <tr><th style="width:30%">المشروع</th><td><span t-field="o.project_id"/></td></tr>
                            <tr><th>التاريخ</th><td><span t-field="o.request_date"/></td></tr>
                            <tr><th>مقدّم الطلب</th><td><span t-field="o.requested_by_id"/></td></tr>
                            <tr><th>الحالة</th><td><span t-field="o.state"/></td></tr>
