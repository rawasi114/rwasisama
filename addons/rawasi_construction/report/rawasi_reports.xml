<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════ منافسة (Competition) ════════════════ -->
    <record id="action_report_competition" model="ir.actions.report">
        <field name="name">تقرير المنافسة</field>
        <field name="model">rawasi.competition</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rawasi_construction.report_competition</field>
        <field name="report_file">rawasi_construction.report_competition</field>
        <field name="binding_model_id" ref="model_rawasi_competition"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_competition">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="doc" t-value="o"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">تقرير المنافسة</h2>
                        <h4 class="text-center"><span t-field="o.name"/></h4>
                        <table class="table table-sm">
                            <tr><th style="width:30%">الرقم المرجعي</th><td><span t-field="o.reference"/></td></tr>
                            <tr><th>الجهة المالكة</th><td><span t-field="o.entity_name"/></td></tr>
                            <tr><th>موعد التقديم</th><td><span t-field="o.submission_deadline"/></td></tr>
                            <tr><th>الحالة</th><td><span t-field="o.state"/></td></tr>
                        </table>
                        <h5>جدول الكميات</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>#</th><th>البند</th><th>الوحدة</th>
                                    <th class="text-end">الكمية</th>
                                    <th class="text-end">تكلفة الوحدة</th>
                                    <th class="text-end">سعر الوحدة</th>
                                    <th class="text-end">الإجمالي</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.boq_item_ids" t-as="it">
                                    <td><span t-field="it.serial"/></td>
                                    <td><span t-field="it.name"/></td>
                                    <td><span t-field="it.unit_id"/></td>
                                    <td class="text-end"><span t-field="it.quantity"/></td>
                                    <td class="text-end"><span t-field="it.unit_cost"/></td>
                                    <td class="text-end"><span t-field="it.unit_price"/></td>
                                    <td class="text-end"><span t-field="it.total_price"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm">
                            <tr><th style="width:70%" class="text-end">إجمالي التكلفة</th><td class="text-end"><span t-field="o.amount_total_cost"/></td></tr>
                            <tr><th class="text-end">المبلغ بدون ضريبة</th><td class="text-end"><span t-field="o.amount_total_price"/></td></tr>
                            <tr><th class="text-end">الضريبة</th><td class="text-end"><span t-field="o.amount_tax"/></td></tr>
                            <tr><th class="text-end">الإجمالي شامل الضريبة</th><td class="text-end"><span t-field="o.amount_total_incl_tax"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ════════════════ طلب مواد (MR) ════════════════ -->
