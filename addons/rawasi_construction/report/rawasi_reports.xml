                            <thead>
                                <tr><th>بند BOQ</th><th>الوصف</th><th class="text-end">الكمية</th><th>الوحدة</th><th class="text-end">تكلفة الوحدة</th><th class="text-end">الإجمالي</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l">
                                    <td><span t-field="l.boq_item_id"/></td>
                                    <td><span t-field="l.description"/></td>
                                    <td class="text-end"><span t-field="l.quantity"/></td>
                                    <td><span t-field="l.unit_id"/></td>
                                    <td class="text-end"><span t-field="l.unit_cost"/></td>
                                    <td class="text-end"><span t-field="l.amount_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm">
                            <tr><th style="width:70%" class="text-end">الإجمالي</th><td class="text-end"><span t-field="o.amount_total"/></td></tr>
                        </table>
                        <p t-if="o.note"><strong>ملاحظات: </strong><span t-field="o.note"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>

