        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rawasi_construction.report_dsr</field>
        <field name="report_file">rawasi_construction.report_dsr</field>
        <field name="binding_model_id" ref="model_rawasi_daily_report"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_dsr">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="doc" t-value="o"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">التقرير اليومي للموقع</h2>
                        <h4 class="text-center"><span t-field="o.name"/></h4>
                        <table class="table table-sm">
                            <tr><th style="width:30%">المشروع</th><td><span t-field="o.project_id"/></td></tr>
                            <tr><th>التاريخ</th><td><span t-field="o.report_date"/></td></tr>
                            <tr><th>أعدّه</th><td><span t-field="o.prepared_by_id"/></td></tr>
                            <tr><th>الطقس</th><td><span t-field="o.weather"/></td></tr>
                            <tr><th>درجة الحرارة</th><td><span t-field="o.temperature"/></td></tr>
                            <tr><th>إجمالي العمالة</th><td><span t-field="o.total_workers"/></td></tr>
                            <tr><th>الحالة</th><td><span t-field="o.state"/></td></tr>
                        </table>
                        <h5>العمالة</h5>
                        <table class="table table-sm">
                            <thead><tr><th>التخصص</th><th class="text-end">العدد</th><th>ملاحظة</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.labor_ids" t-as="lb">
                                    <td><span t-field="lb.trade"/></td>
                                    <td class="text-end"><span t-field="lb.worker_count"/></td>
                                    <td><span t-field="lb.note"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-if="o.work_done"><strong>الأعمال المنفّذة: </strong><span t-field="o.work_done"/></p>
                        <p t-if="o.delays"><strong>المعوقات: </strong><span t-field="o.delays"/></p>
                        <p t-if="o.equipment"><strong>المعدات: </strong><span t-field="o.equipment"/></p>
                        <p t-if="o.visitors"><strong>الزوار: </strong><span t-field="o.visitors"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>

