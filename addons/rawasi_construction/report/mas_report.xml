<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- إجراء تقرير غلاف اعتماد المادة (يُدمج لاحقاً مع المرفقات في PDF واحد) -->
    <record id="action_report_mas_cover" model="ir.actions.report">
        <field name="name">غلاف اعتماد المادة</field>
        <field name="model">rawasi.material.approval</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rawasi_construction.report_mas_cover</field>
        <field name="report_file">rawasi_construction.report_mas_cover</field>
        <field name="binding_model_id" ref="model_rawasi_material_approval"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mas_cover">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="doc" t-value="o"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">طلب اعتماد مادة (Material Approval Submission)</h2>
                        <h4 class="text-center" t-out="o.name"/>
                        <table class="table table-sm mt-4">
                            <tr>
                                <th style="width:30%">المشروع</th>
                                <td t-out="o.project_id.display_name"/>
                            </tr>
                            <tr>
                                <th>بند جدول الكميات</th>
                                <td t-out="o.boq_item_id.name"/>
                            </tr>
                            <tr>
                                <th>المادة</th>
                                <td t-out="o.material_name"/>
                            </tr>
                            <tr>
                                <th>المُصنّع</th>
                                <td t-out="o.manufacturer or ''"/>
                            </tr>
                            <tr>
                                <th>المورد</th>
                                <td t-out="o.supplier or ''"/>
                            </tr>
                            <tr>
                                <th>تاريخ الرفع</th>
                                <td t-out="o.submittal_date"/>
                            </tr>
                            <tr>
                                <th>الاستشاري المراجِع</th>
                                <td t-out="o.consultant_id.name or ''"/>
                            </tr>
                            <tr>
                                <th>الحالة</th>
                                <td><span t-field="o.state"/></td>
                            </tr>
                        </table>
                        <div t-if="o.consultant_remarks" class="mt-3">
                            <h5>ملاحظات الاستشاري</h5>
                            <p t-out="o.consultant_remarks"/>
                        </div>
                        <div t-if="o.note" class="mt-3">
                            <h5>ملاحظات</h5>
                            <p t-out="o.note"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
