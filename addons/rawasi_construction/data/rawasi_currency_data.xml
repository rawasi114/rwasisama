<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: يُطبَّق مرة واحدة عند التثبيت. -->
    <data noupdate="1">
        <!-- تفعيل عملة الريال السعودي فقط (آمن).
             لا نغيّر عملة الشركة هنا لأن أودو يمنع ذلك عند وجود قيود محاسبية
             (يفشل البناء على Odoo.sh). تُضبط عملة الشركة يدوياً من:
             الإعدادات ← المستخدمون والشركات ← الشركات ← العملة. -->
        <record id="base.SAR" model="res.currency">
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

