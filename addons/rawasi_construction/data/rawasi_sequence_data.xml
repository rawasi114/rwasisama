<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_material_request" model="ir.sequence">
            <field name="name">طلب مواد</field>
            <field name="code">rawasi.material.request</field>
            <field name="prefix">MR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_purchase_order" model="ir.sequence">
            <field name="name">أمر شراء</field>
            <field name="code">rawasi.purchase.order</field>
            <field name="prefix">PO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_goods_receipt" model="ir.sequence">
            <field name="name">سند استلام</field>
            <field name="code">rawasi.goods.receipt</field>
            <field name="prefix">GRN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_document" model="ir.sequence">
            <field name="name">مستند مشروع</field>
            <field name="code">rawasi.document</field>
            <field name="prefix">DOC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_material_approval" model="ir.sequence">
            <field name="name">اعتماد مادة</field>
            <field name="code">rawasi.material.approval</field>
            <field name="prefix">MAS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_daily_report" model="ir.sequence">
            <field name="name">تقرير يومي</field>
            <field name="code">rawasi.daily.report</field>
            <field name="prefix">DSR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_ncr" model="ir.sequence">
            <field name="name">تقرير عدم مطابقة</field>
            <field name="code">rawasi.ncr</field>
            <field name="prefix">NCR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_rfi" model="ir.sequence">
            <field name="name">طلب معلومات</field>
            <field name="code">rawasi.rfi</field>
            <field name="prefix">RFI/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
