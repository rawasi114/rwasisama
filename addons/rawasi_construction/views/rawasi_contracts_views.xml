<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════ أمر تغيير (VO) ════════════════ -->
    <record id="view_variation_order_list" model="ir.ui.view">
        <field name="name">rawasi.variation.order.list</field>
        <field name="model">rawasi.variation.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="subject"/>
                <field name="vo_type"/>
                <field name="vo_date"/>
                <field name="amount_total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-info="state == 'submitted'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_variation_order_form" model="ir.ui.view">
        <field name="name">rawasi.variation.order.form</field>
        <field name="model">rawasi.variation.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="تقديم"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="اعتماد وتطبيق على BOQ"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_print_with_attachments" type="object"
                            string="طباعة مع المرفقات" class="btn-secondary"
                            invisible="not attachment_ids"/>
                    <button name="action_reject" type="object" string="رفض"
                            invisible="state != 'submitted'"/>
                    <button name="action_reset_to_draft" type="object" string="إعادة لمسودة"
                            groups="base.group_system" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-success" role="alert" invisible="not applied">
                        تم تطبيق هذا الأمر على جدول الكميات.
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="subject"/>
                            <field name="vo_type"/>
                        </group>
                        <group>
                            <field name="vo_date"/>
                            <field name="applied" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="change_type"/>
                            <field name="boq_item_id"/>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="unit_cost"/>
                            <field name="unit_price"/>
                            <field name="amount_subtotal"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_total"/>
                    </group>
                    <field name="reason" placeholder="مبرّر التغيير..."/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_variation_order" model="ir.actions.act_window">
        <field name="name">أوامر التغيير</field>
        <field name="res_model">rawasi.variation.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ════════════════ مستخلص دفع (IPC) ════════════════ -->
    <record id="view_payment_certificate_list" model="ir.ui.view">
        <field name="name">rawasi.payment.certificate.list</field>
        <field name="model">rawasi.payment.certificate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="sequence_no"/>
                <field name="period_to"/>
                <field name="amount_net"/>
                <field name="amount_total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('approved','paid')"
                       decoration-info="state == 'submitted'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_payment_certificate_form" model="ir.ui.view">
        <field name="name">rawasi.payment.certificate.form</field>
        <field name="model">rawasi.payment.certificate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_lines" type="object"
                            string="توليد البنود من المشروع" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_submit" type="object" string="تقديم"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="اعتماد"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_mark_paid" type="object" string="تعليم كمدفوع"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_print_with_attachments" type="object"
                            string="طباعة مع المرفقات" class="btn-secondary"
                            invisible="not attachment_ids"/>
                    <button name="action_reject" type="object" string="رفض"
                            invisible="state != 'submitted'"/>
                    <button name="action_reset_to_draft" type="object" string="إعادة لمسودة"
                            groups="base.group_system" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="sequence_no"/>
                        </group>
                        <group>
                            <field name="period_from"/>
                            <field name="period_to"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="boq_item_id"/>
                            <field name="unit_id"/>
                            <field name="contract_qty"/>
                            <field name="unit_price"/>
                            <field name="prev_qty"/>
                            <field name="work_qty"/>
                            <field name="cumulative_qty"/>
                            <field name="cumulative_pct"/>
                            <field name="amount_work"/>
                            <field name="amount_cumulative" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group>
                        <group>
                            <field name="retention_pct"/>
                            <field name="advance_recovery"/>
                            <field name="vat_rate"/>
                        </group>
                        <group class="oe_subtotal_footer">
                            <field name="amount_work_period"/>
                            <field name="retention_amount"/>
                            <field name="amount_net"/>
                            <field name="amount_tax"/>
                            <field name="amount_total" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payment_certificate" model="ir.actions.act_window">
        <field name="name">المستخلصات</field>
        <field name="res_model">rawasi.payment.certificate</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ════════════════ ضمان بنكي (BG) ════════════════ -->
    <record id="view_bank_guarantee_list" model="ir.ui.view">
        <field name="name">rawasi.bank.guarantee.list</field>
        <field name="model">rawasi.bank.guarantee</field>
        <field name="arch" type="xml">
            <list decoration-danger="expiry_state == 'expired'"
                  decoration-warning="expiry_state == 'soon'">
                <field name="name"/>
                <field name="guarantee_type"/>
                <field name="bank_name"/>
                <field name="reference_no"/>
                <field name="project_id" optional="show"/>
                <field name="amount"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="expiry_state" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'released'"
                       decoration-danger="state in ('claimed','expired')"/>
            </list>
        </field>
    </record>

    <record id="view_bank_guarantee_form" model="ir.ui.view">
        <field name="name">rawasi.bank.guarantee.form</field>
        <field name="model">rawasi.bank.guarantee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print_with_attachments" type="object"
                            string="طباعة مع المرفقات" class="btn-secondary"
                            invisible="not attachment_ids"/>
                    <button name="action_release" type="object" string="إفراج"
                            groups="base.group_system" invisible="state != 'active'"/>
                    <button name="action_claim" type="object" string="مصادرة"
                            groups="base.group_system" invisible="state != 'active'"/>
                    <button name="action_set_active" type="object" string="إرجاع لساري"
                            groups="base.group_system" invisible="state == 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="guarantee_type"/>
                            <field name="bank_name"/>
                            <field name="reference_no"/>
                            <field name="beneficiary"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="competition_id"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry"/>
                            <field name="expiry_state"/>
                        </group>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bank_guarantee_search" model="ir.ui.view">
        <field name="name">rawasi.bank.guarantee.search</field>
        <field name="model">rawasi.bank.guarantee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference_no"/>
                <field name="bank_name"/>
                <field name="project_id"/>
                <filter name="active" string="ساري" domain="[('state','=','active')]"/>
                <filter name="soon" string="قريب الانتهاء" domain="[('expiry_state','=','soon')]"/>
                <filter name="expired" string="منتهٍ" domain="[('expiry_state','=','expired')]"/>
                <group>
                    <filter name="g_type" string="النوع" context="{'group_by':'guarantee_type'}"/>
                    <filter name="g_state" string="الحالة" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bank_guarantee" model="ir.actions.act_window">
        <field name="name">الضمانات البنكية</field>
        <field name="res_model">rawasi.bank.guarantee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bank_guarantee_search"/>
    </record>
</odoo>
