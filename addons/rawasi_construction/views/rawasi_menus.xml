<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- لوحة التحكم: client action تعرض مكوّن OWL -->
        <record id="action_rawasi_dashboard" model="ir.actions.client">
            <field name="name">لوحة التحكم</field>
            <field name="tag">rawasi_dashboard</field>
        </record>

        <!-- قائمة التطبيق الرئيسية (تظهر في "التطبيقات") -->
        <menuitem id="menu_rawasi_root"
                  name="رواسي سما"
                  web_icon="rawasi_construction,static/description/icon.png"
                  sequence="10"
                  groups="group_site_engineer,group_accountant,group_planning_engineer,group_tech_office_manager,group_projects_director,group_external_consultant,group_ceo"/>

        <menuitem id="menu_rawasi_dashboard"
                  name="لوحة التحكم"
                  parent="menu_rawasi_root"
                  action="action_rawasi_dashboard"
                  sequence="10"/>

        <menuitem id="menu_rawasi_competitions"
                  name="المنافسات"
                  parent="menu_rawasi_root"
                  action="action_rawasi_competition"
                  sequence="20"/>

        <menuitem id="menu_rawasi_wbs"
                  name="الجداول الزمنية (WBS)"
                  parent="menu_rawasi_root"
                  action="action_wbs_activity"
                  sequence="30"/>

        <!-- الإعدادات -->
        <menuitem id="menu_rawasi_config"
                  name="الإعدادات"
                  parent="menu_rawasi_root"
                  sequence="90"
                  groups="group_tech_office_manager,group_projects_director,group_ceo"/>
        <menuitem id="menu_rawasi_units"
                  name="وحدات القياس"
                  parent="menu_rawasi_config"
                  action="action_rawasi_unit"
                  sequence="10"/>
        <menuitem id="menu_rawasi_sbc"
                  name="رموز كود البناء (SBC)"
                  parent="menu_rawasi_config"
                  action="action_rawasi_sbc"
                  sequence="20"/>
        <menuitem id="menu_rawasi_wbs_phase"
                  name="المراحل القياسية (WBS)"
                  parent="menu_rawasi_config"
                  action="action_wbs_phase"
                  sequence="30"/>
    </data>
</odoo>
