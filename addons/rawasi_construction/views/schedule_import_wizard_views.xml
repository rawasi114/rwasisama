<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_schedule_import_wizard_form" model="ir.ui.view">
        <field name="name">rawasi.schedule.import.wizard.form</field>
        <field name="model">rawasi.schedule.import.wizard</field>
        <field name="arch" type="xml">
            <form string="استيراد الجدول الزمني">
                <field name="project_id" invisible="1"/>
                <group>
                    <field name="file" filename="filename" widget="binary"/>
                    <field name="filename" invisible="1"/>
                    <field name="replace_existing"/>
                </group>
                <div class="alert alert-info" role="alert">
                    يستورد الأنشطة عبر مطابقة عناوين الأعمدة (النشاط، المرحلة،
                    تاريخ البداية، تاريخ النهاية، نسبة الإنجاز).
                </div>
                <footer>
                    <button name="action_import" type="object" string="استيراد"
                            class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
