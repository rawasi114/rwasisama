<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_boq_import_wizard_form" model="ir.ui.view">
        <field name="name">rawasi.boq.import.wizard.form</field>
        <field name="model">rawasi.boq.import.wizard</field>
        <field name="arch" type="xml">
            <form string="استيراد جدول الكميات">
                <field name="competition_id" invisible="1"/>
                <group>
                    <field name="file" filename="filename" widget="binary"/>
                    <field name="filename" invisible="1"/>
                    <field name="replace_existing"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <p>لتسهيل العمل: حمّل <b>قالب جدول الكميات</b> (Excel)، عبّئه ثم ارفعه هنا واستورد.</p>
                    <p>القالب يحوي عمود <b>تكلفة الوحدة</b> وعمود سعر الوحدة، فإن سعّرت في الملف يُرفع البند مُسعّراً تلقائياً.</p>
                    <p>المطابقة بأسماء الأعمدة (لا يهمّ ترتيبها)، مع تطبيع وحدات القياس وتعبئة الفئة تلقائياً.</p>
                </div>
                <footer>
                    <button name="action_download_template" type="object"
                            string="تحميل قالب جدول الكميات" class="btn-secondary"/>
                    <button name="action_import" type="object" string="استيراد"
                            class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
