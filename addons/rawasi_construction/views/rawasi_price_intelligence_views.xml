<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_price_intelligence_list" model="ir.ui.view">
        <field name="name">rawasi.price.intelligence.list</field>
        <field name="model">rawasi.price.intelligence</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="price_date"/>
                <field name="name"/>
                <field name="unit_id" optional="show"/>
                <field name="quantity" optional="hide"/>
                <field name="unit_cost"/>
                <field name="unit_price"/>
                <field name="margin_pct" optional="show"/>
                <field name="sbc_code_id" optional="hide"/>
                <field name="lcgpa_code_id" optional="hide"/>
                <field name="reference_item_id" optional="show"/>
                <field name="reference_match_source" optional="hide" widget="badge"/>
                <field name="reference_match_confidence" optional="hide" widget="progressbar"/>
                <field name="competition_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="outcome" widget="badge"
                       decoration-success="outcome == 'won'"
                       decoration-danger="outcome == 'lost'"
                       decoration-info="outcome == 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="view_price_intelligence_form" model="ir.ui.view">
        <field name="name">rawasi.price.intelligence.form</field>
        <field name="model">rawasi.price.intelligence</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="unit_id"/>
                            <field name="quantity"/>
                            <field name="sbc_code_id"/>
                            <field name="lcgpa_code_id"/>
                        </group>
                        <group>
                            <field name="unit_cost"/>
                            <field name="unit_price"/>
                            <field name="margin_pct"/>
                            <field name="price_date"/>
                            <field name="outcome"/>
                            <field name="competition_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="ربط الكتالوج المرجعي" colspan="2">
                            <field name="reference_item_id"/>
                            <field name="reference_match_source" widget="badge"/>
                            <field name="reference_match_confidence" widget="progressbar"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_price_intelligence_search" model="ir.ui.view">
        <field name="name">rawasi.price.intelligence.search</field>
        <field name="model">rawasi.price.intelligence</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sbc_code_id"/>
                <field name="unit_id"/>
                <field name="competition_id"/>
                <filter name="won" string="فائز" domain="[('outcome','=','won')]"/>
                <filter name="lost" string="خاسر" domain="[('outcome','=','lost')]"/>
                <filter name="submitted" string="مقدَّم" domain="[('outcome','=','submitted')]"/>
                <group>
                    <filter name="g_outcome" string="النتيجة" context="{'group_by':'outcome'}"/>
                    <filter name="g_unit" string="الوحدة" context="{'group_by':'unit_id'}"/>
                    <filter name="g_sbc" string="رمز SBC" context="{'group_by':'sbc_code_id'}"/>
                    <filter name="g_comp" string="المنافسة" context="{'group_by':'competition_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_price_intelligence_pivot" model="ir.ui.view">
        <field name="name">rawasi.price.intelligence.pivot</field>
        <field name="model">rawasi.price.intelligence</field>
        <field name="arch" type="xml">
            <pivot string="ذاكرة الأسعار">
                <field name="sbc_code_id" type="row"/>
                <field name="outcome" type="col"/>
                <field name="unit_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_price_intelligence_graph" model="ir.ui.view">
        <field name="name">rawasi.price.intelligence.graph</field>
        <field name="model">rawasi.price.intelligence</field>
        <field name="arch" type="xml">
            <graph string="ذاكرة الأسعار" type="bar" sample="1">
                <field name="outcome"/>
                <field name="unit_price" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_price_intelligence" model="ir.actions.act_window">
        <field name="name">ذاكرة الأسعار</field>
        <field name="res_model">rawasi.price.intelligence</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_price_intelligence_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لا توجد أسعار محفوظة بعد</p>
            <p>تُحفظ الأسعار تلقائياً في ذاكرة المؤسسة عند تقديم كل منافسة،
               وتُحدَّث نتيجتها (فائز/خاسر) عند الترسية.</p>
        </field>
    </record>
</odoo>
