<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subcontractor_list" model="ir.ui.view">
        <field name="name">rawasi.subcontractor.list</field>
        <field name="model">rawasi.subcontractor</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="vat_number"/>
                <field name="subcontract_count" string="عقود"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_subcontractor_form" model="ir.ui.view">
        <field name="name">rawasi.subcontractor.form</field>
        <field name="model">rawasi.subcontractor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_subcontracts" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="subcontract_count" widget="statinfo" string="العقود"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h2><field name="code" readonly="1"/></h2>
                        <h1><field name="name" placeholder="الاسم التجاري"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="cr_number"/>
                            <field name="vat_number"/>
                            <field name="specialization"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="bank_name"/>
                            <field name="iban"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="المرفقات" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="ملاحظات" name="notes">
                            <field name="notes" placeholder="ملاحظات..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_subcontractor_search" model="ir.ui.view">
        <field name="name">rawasi.subcontractor.search</field>
        <field name="model">rawasi.subcontractor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="specialization"/>
                <field name="vat_number"/>
                <filter name="archived" string="مؤرشف" domain="[('active','=',False)]"/>
                <group>
                    <filter name="g_spec" string="التخصص" context="{'group_by':'specialization'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_subcontractor" model="ir.actions.act_window">
        <field name="name">سجل المقاولين</field>
        <field name="res_model">rawasi.subcontractor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subcontractor_search"/>
    </record>
</odoo>
