<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ دفعة الاستيراد ═══ -->
    <record id="view_import_batch_search" model="ir.ui.view">
        <field name="name">rawasi.import.batch.search</field>
        <field name="model">rawasi.import.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="filename"/>
                <field name="linked_tender_id"/>
                <field name="source_entity_id"/>
                <filter name="draft" string="مسودة" domain="[('state','=','draft')]"/>
                <filter name="reviewing" string="قيد المراجعة" domain="[('state','=','reviewing')]"/>
                <filter name="approved" string="معتمَدة" domain="[('state','=','approved')]"/>
                <group>
                    <filter name="g_state" string="حسب الحالة" context="{'group_by':'state'}"/>
                    <filter name="g_tender" string="حسب المنافسة" context="{'group_by':'linked_tender_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_import_batch_list" model="ir.ui.view">
        <field name="name">rawasi.import.batch.list</field>
        <field name="model">rawasi.import.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="upload_date"/>
                <field name="filename"/>
                <field name="linked_tender_id"/>
                <field name="total_lines"/>
                <field name="matched_lines" optional="show"/>
                <field name="pending_lines" optional="show" decoration-warning="pending_lines &gt; 0"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'reviewing'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="uploaded_by_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_import_batch_form" model="ir.ui.view">
        <field name="name">rawasi.import.batch.form</field>
        <field name="model">rawasi.import.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import_approval" type="object"
                            string="اعتماد الاستيراد" class="btn-success"
                            invisible="state in ('approved','cancelled')"/>
                    <button name="action_accept_all_high_confidence" type="object"
                            string="قبول كل عالي الثقة (≥85%)"
                            invisible="state in ('approved','cancelled') or pending_lines == 0"/>
                    <button name="action_reject_all_pending" type="object"
                            string="رفض كل المعلَّقة"
                            invisible="state in ('approved','cancelled') or pending_lines == 0"
                            confirm="سيُرفض كل السطور المعلَّقة. متأكد؟"/>
                    <button name="action_cancel" type="object"
                            string="إلغاء" class="btn-secondary"
                            invisible="state in ('approved','cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="filename"/>
                        <h1><field name="filename" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="linked_tender_id"
                                   readonly="state in ('approved','cancelled')"
                                   options="{'no_create_edit': True}"/>
                            <field name="source_entity_id"/>
                            <field name="file_data" filename="filename" readonly="1"/>
                        </group>
                        <group>
                            <field name="upload_date" readonly="1"/>
                            <field name="uploaded_by_user_id" readonly="1"/>
                            <field name="total_lines" readonly="1"/>
                            <field name="matched_lines" readonly="1"/>
                            <field name="pending_lines" readonly="1"/>
                            <field name="accepted_lines" readonly="1"/>
                            <field name="saved_lines" readonly="1"/>
                            <field name="rejected_lines" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="سطور الجدول المُستلَمة" name="lines">
                            <field name="import_batch_line_ids"
                                   readonly="state in ('approved','cancelled')">
                                <list editable="bottom">
                                    <field name="line_number"/>
                                    <field name="original_main_category" optional="show"/>
                                    <field name="original_item_group" optional="show"/>
                                    <field name="original_simplified_desc" optional="show"/>
                                    <field name="original_text"/>
                                    <field name="original_unit" optional="show"/>
                                    <field name="normalized_unit_code" optional="show" widget="badge"/>
                                    <field name="original_quantity" optional="show"/>
                                    <field name="original_unit_cost" optional="show" string="تكلفة الوحدة"/>
                                    <field name="original_unit_price" optional="show" string="سعر الوحدة"/>
                                    <field name="suggested_match_id" optional="show"/>
                                    <field name="suggestion_confidence" optional="show" widget="progressbar"/>
                                    <field name="suggestion_source" optional="hide" widget="badge"/>
                                    <field name="review_status" optional="show" widget="badge"
                                           decoration-warning="review_status == 'pending'"
                                           decoration-success="review_status in ['accepted','modified','created_new']"
                                           decoration-info="review_status == 'saved'"
                                           decoration-danger="review_status == 'rejected'"/>
                                    <button name="action_accept" type="object"
                                            string="قبول" icon="fa-check"
                                            invisible="review_status != 'pending' or not suggested_match_id"/>
                                    <button name="action_reject" type="object"
                                            string="رفض" icon="fa-times"
                                            invisible="review_status == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                        <page string="ملاحظات" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_import_batch_line_form" model="ir.ui.view">
        <field name="name">rawasi.import.batch.line.form</field>
        <field name="model">rawasi.import.batch.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_accept" type="object"
                            string="قبول الترشيح" class="btn-success"
                            invisible="review_status != 'pending' or not suggested_match_id"/>
                    <button name="action_reject" type="object"
                            string="رفض السطر" class="btn-danger"
                            invisible="review_status == 'rejected'"/>
                    <field name="review_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="السطر كما ورد (الهرمية)">
                            <field name="import_batch_id" readonly="1"/>
                            <field name="line_number" readonly="1"/>
                            <field name="original_main_category"/>
                            <field name="original_item_group"/>
                            <field name="original_simplified_desc"/>
                            <field name="original_unit"/>
                            <field name="normalized_unit_code" readonly="1" widget="badge"/>
                            <field name="original_quantity"/>
                            <field name="original_construction_code"/>
                        </group>
                        <group string="منظومة المطابقة">
                            <field name="suggested_match_id" readonly="1"/>
                            <field name="suggestion_confidence" readonly="1" widget="progressbar"/>
                            <field name="suggestion_source" readonly="1" widget="badge"/>
                            <field name="detected_lcgpa_id" readonly="1"/>
                            <field name="final_match_id"
                                   options="{'no_create_edit': True}"/>
                        </group>
                    </group>
                    <group string="التكلفة والتسعير">
                        <group>
                            <field name="original_unit_cost"/>
                        </group>
                        <group>
                            <field name="original_unit_price"/>
                        </group>
                    </group>
                    <group string="الوصف الكامل كما بالجدول">
                        <field name="original_text" nolabel="1" readonly="1"/>
                    </group>
                    <group string="المواصفات المُستخلَصة تلقائياً">
                        <group>
                            <field name="extracted_dimensions" readonly="1"/>
                            <field name="extracted_thickness" readonly="1"/>
                        </group>
                        <group>
                            <field name="extracted_diameter" readonly="1"/>
                            <field name="extracted_strength" readonly="1"/>
                        </group>
                    </group>
                    <group string="ملاحظات المراجع">
                        <field name="reviewer_notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_import_batch_line_list" model="ir.ui.view">
        <field name="name">rawasi.import.batch.line.list</field>
        <field name="model">rawasi.import.batch.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="line_number"/>
                <field name="original_main_category"/>
                <field name="original_item_group"/>
                <field name="original_text"/>
                <field name="suggested_match_id"/>
                <field name="suggestion_confidence" widget="progressbar"/>
                <field name="review_status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_import_batch" model="ir.actions.act_window">
        <field name="name">دفعات الاستيراد</field>
        <field name="res_model">rawasi.import.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_import_batch_search"/>
    </record>

    <!-- ═══ الـ Wizard ═══ -->
    <record id="view_reference_items_import_wizard_form" model="ir.ui.view">
        <field name="name">rawasi.reference.items.import.wizard.form</field>
        <field name="model">rawasi.reference.items.import.wizard</field>
        <field name="arch" type="xml">
            <form string="استيراد جدول كميات (سجل البنود المرجعي)">
                <sheet>
                    <div class="oe_title">
                        <h1>استيراد جدول كميات</h1>
                        <p class="text-muted">
                            ارفع ملف Excel + اختر منافسة (إلزامي). المعالج يحلّل الهرمية الرباعية،
                            يطبّق التوحيد التلقائي، يستخلص المواصفات، ويُشغّل منظومة المطابقة الذكية
                            بأربعة مستويات.
                        </p>
                    </div>
                    <group>
                        <field name="file_data" filename="filename" widget="binary"/>
                        <field name="filename"/>
                        <field name="linked_tender_id"
                               options="{'no_create_edit': False}"/>
                        <field name="source_entity_id"/>
                    </group>
                    <group string="ملاحظات">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_analyze" type="object"
                            string="تحليل وبدء المراجعة" class="btn-primary"/>
                    <button special="cancel" string="إلغاء" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reference_items_import_wizard" model="ir.actions.act_window">
        <field name="name">معالج استيراد جدول كميات</field>
        <field name="res_model">rawasi.reference.items.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
