<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- قواعد سجلات تعدّد الشركات (Multi-Company Record Rules):
         كل سجل يحوي company_id يُرى فقط من قِبل المستخدمين المسموح لهم بشركته.
         الصياغة `('company_id', 'in', company_ids)` يُترجمها أودو تلقائياً إلى
         الشركات المُفعَّلة في جلسة المستخدم (env.companies). -->
    <data noupdate="1">
        <record id="rule_competition_company" model="ir.rule">
            <field name="name">المنافسة: متعدد الشركات</field>
            <field name="model_id" ref="model_rawasi_competition"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_boq_item_company" model="ir.rule">
            <field name="name">بند جدول الكميات: متعدد الشركات</field>
