<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ────── قواعد عزل بحسب المشروع لمهندس الموقع فقط ──────
             الأدوار الأخرى (مكتب فني، مدير مشاريع، محاسب، مدير عام، أدمن)
             لا تتأثر بهذه القواعد ويرون كل شيء. -->
        <record id="rule_subcontract_site_engineer" model="ir.rule">
            <field name="name">عقد فرعي: مهندس الموقع — مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_subcontract"/>
            <field name="domain_force">[('project_id.site_engineer_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_site_engineer'))]"/>
        </record>
        <record id="rule_subcontract_ipc_site_engineer" model="ir.rule">
            <field name="name">مستخلص فرعي: مهندس الموقع — مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_subcontract_ipc"/>
            <field name="domain_force">[('subcontract_id.project_id.site_engineer_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_site_engineer'))]"/>
        </record>
        <record id="rule_subcontractor_site_engineer" model="ir.rule">
            <field name="name">مقاول من الباطن: مهندس الموقع — مقاولو مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_subcontractor"/>
            <field name="domain_force">[('subcontract_ids.project_id.site_engineer_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_site_engineer'))]"/>
        </record>

        <!-- ────── قواعد متعدد الشركات (عالمية لكل المستخدمين) ────── -->
        <record id="rule_subcontractor_company" model="ir.rule">
            <field name="name">مقاول من الباطن: متعدد الشركات</field>
            <field name="model_id" ref="model_rawasi_subcontractor"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_subcontract_company" model="ir.rule">
            <field name="name">عقد فرعي: متعدد الشركات</field>
            <field name="model_id" ref="model_rawasi_subcontract"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_subcontract_ipc_company" model="ir.rule">
            <field name="name">مستخلص فرعي: متعدد الشركات</field>
            <field name="model_id" ref="model_rawasi_subcontract_ipc"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
