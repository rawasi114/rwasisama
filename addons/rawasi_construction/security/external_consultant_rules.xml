<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ────── تقييد الاستشاري الخارجي بمشاريعه فقط ──────
             يعتمد على حقل project_id.consultant_ids على project.project.
             أي قراءة/كتابة من استشاري خارجي على هذه الموديلات تُفلتر
             لتشمل فقط المشاريع المُكلَّف بها.

             ملاحظة: لا نقيّد المحاسب لأنه يحتاج رؤية مالية شاملة،
             ولا نقيّد المخطط ومدير المكتب الفني لأن دورهم تخطيطي
             يتطلب رؤية كل المنافسات والمشاريع. -->

        <record id="rule_competition_consultant" model="ir.rule">
            <field name="name">المنافسة: استشاري — مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_competition"/>
            <field name="domain_force">[('project_id.consultant_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_external_consultant'))]"/>
        </record>

        <record id="rule_boq_item_consultant" model="ir.rule">
            <field name="name">بند BoQ: استشاري — مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_boq_item"/>
            <field name="domain_force">[('competition_id.project_id.consultant_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_external_consultant'))]"/>
        </record>

        <record id="rule_indirect_cost_consultant" model="ir.rule">
            <field name="name">تكلفة غير مباشرة: استشاري — مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_indirect_cost"/>
            <field name="domain_force">[('competition_id.project_id.consultant_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_external_consultant'))]"/>
        </record>

        <record id="rule_document_consultant" model="ir.rule">
            <field name="name">مستند مشروع: استشاري — مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_document"/>
            <field name="domain_force">[('project_id.consultant_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_external_consultant'))]"/>
        </record>

        <record id="rule_mas_consultant" model="ir.rule">
            <field name="name">اعتماد مادة: استشاري — مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_material_approval"/>
