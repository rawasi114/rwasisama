            <field name="groups" eval="[(4, ref('group_external_consultant'))]"/>
        </record>

        <record id="rule_dsr_consultant" model="ir.rule">
            <field name="name">تقرير يومي: استشاري — مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_daily_report"/>
            <field name="domain_force">[('project_id.consultant_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_external_consultant'))]"/>
        </record>

        <record id="rule_dsr_labor_consultant" model="ir.rule">
            <field name="name">بند عمالة تقرير يومي: استشاري — مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_daily_report_labor"/>
            <field name="domain_force">[('report_id.project_id.consultant_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_external_consultant'))]"/>
        </record>

        <record id="rule_ncr_consultant" model="ir.rule">
            <field name="name">عدم مطابقة: استشاري — مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_ncr"/>
            <field name="domain_force">[('project_id.consultant_ids', 'in', [user.id])]</field>
