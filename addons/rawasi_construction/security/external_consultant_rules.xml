            <field name="groups" eval="[(4, ref('group_external_consultant'))]"/>
        </record>

        <record id="rule_wbs_activity_consultant" model="ir.rule">
            <field name="name">نشاط WBS: استشاري — مشاريعه فقط</field>
            <field name="model_id" ref="model_rawasi_wbs_activity"/>
            <field name="domain_force">[('project_id.consultant_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_external_consultant'))]"/>
        </record>
    </data>
</odoo>
