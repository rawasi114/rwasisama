        <!-- القائمة الجذرية للموديول — تظهر كأيقونة في App Launcher -->
        <menuitem id="menu_root_item_catalog"
                  name="كتالوج البنود"
                  sequence="65"
                  web_icon="rawasi_item_catalog,static/description/icon.png"
                  groups="group_item_catalog_user"/>

        <!-- الكتالوج -->
        <menuitem id="menu_catalog_section"
