<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_item_synonym_search" model="ir.ui.view">
        <field name="name">rawasi.item.synonym.search</field>
        <field name="model">rawasi.item.synonym</field>
        <field name="arch" type="xml">
            <search string="بحث في المرادفات">
                <field name="text_raw"/>
                <field name="text_normalized"/>
                <field name="canonical_item_id"/>
                <field name="source_entity_id"/>
                <separator/>
                <filter name="high_freq" string="عالية التكرار (≥10)"
                        domain="[('frequency','&gt;=',10)]"/>
                <filter name="low_confidence" string="ثقة منخفضة (&lt;0.7)"
                        domain="[('confidence_score','&lt;',0.7)]"/>
                <filter name="recent" string="آخر 30 يوم"
                        domain="[('last_seen_date','&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="تجميع">
                    <filter name="group_by_canonical" string="حسب البند الكنسي"
                            context="{'group_by':'canonical_item_id'}"/>
                    <filter name="group_by_source" string="حسب الجهة المصدر"
                            context="{'group_by':'source_entity_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_item_synonym_list" model="ir.ui.view">
        <field name="name">rawasi.item.synonym.list</field>
        <field name="model">rawasi.item.synonym</field>
        <field name="arch" type="xml">
            <list string="المرادفات" multi_edit="1">
                <field name="text_raw"/>
                <field name="text_normalized" optional="show"/>
                <field name="canonical_item_id"/>
                <field name="source_entity_id" optional="hide"/>
                <field name="frequency"/>
                <field name="first_seen_date" optional="hide"/>
                <field name="last_seen_date"/>
                <field name="confidence_score" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="view_item_synonym_form" model="ir.ui.view">
        <field name="name">rawasi.item.synonym.form</field>
        <field name="model">rawasi.item.synonym</field>
        <field name="arch" type="xml">
            <form string="مرادف بند">
                <sheet>
                    <group>
                        <group>
                            <field name="canonical_item_id"
                                   options="{'no_create': True}"/>
                            <field name="text_raw"/>
                            <field name="text_normalized" readonly="1"/>
                        </group>
                        <group>
                            <field name="source_entity_id"/>
                            <field name="frequency"/>
                            <field name="first_seen_date"/>
                            <field name="last_seen_date"/>
                            <field name="confidence_score" widget="progressbar"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_item_synonym" model="ir.actions.act_window">
        <field name="name">المرادفات</field>
        <field name="res_model">rawasi.item.synonym</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_item_synonym_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لا توجد مرادفات بعد</p>
            <p>المرادفات تتراكم تلقائياً مع كل استيراد جدول كميات (في مرحلة لاحقة)،
               أو يمكن إضافتها يدوياً من نموذج البند الكنسي.</p>
        </field>
    </record>

</odoo>
