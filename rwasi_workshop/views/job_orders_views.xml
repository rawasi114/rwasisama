    <!-- RS-WS-14 أمر شغل CNC -->
    <record id="view_cnc_job_form" model="ir.ui.view">
        <field name="name">rwasi.cnc.job.form</field>
        <field name="model">rwasi.cnc.job</field>
        <field name="arch" type="xml">
            <form string="أمر شغل CNC">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_ref"/>
                            <field name="work_order_id"/>
                        </group>
                        <group>
                            <field name="cad_file"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <group string="إعدادات التشغيل">
                        <group>
                            <field name="machine"/>
                            <field name="machine_no"/>
                            <field name="operator"/>
                            <field name="material"/>
                            <field name="thickness"/>
                        </group>
                        <group>
                            <field name="pcs"/>
                            <field name="tool_bit"/>
                            <field name="rpm"/>
                            <field name="feed_rate"/>
                            <field name="sheet_size"/>
                            <field name="yield_pct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="سجل التشغيل">
                            <field name="run_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="part"/>
                                    <field name="qty"/>
                                    <field name="start"/>
                                    <field name="end"/>
                                    <field name="cycle"/>
                                    <field name="accept_reject"/>
                                </list>
                            </field>
                        </page>
                        <page string="الاعتماد">
                            <group>
                                <group string="مشغل الماكينة">
                                    <field name="prepared_name"/>
                                    <field name="prepared_date"/>
                                    <field name="prepared_signature" widget="signature"/>
                                </group>
                                <group string="مشرف الورشة">
                                    <field name="supervisor_name"/>
                                    <field name="supervisor_date"/>
                                    <field name="supervisor_signature" widget="signature"/>
                                </group>
                                <group string="مدير العمليات">
                                    <field name="manager_name"/>
                                    <field name="manager_date"/>
                                    <field name="manager_signature" widget="signature"/>
                                    <field name="manager_stamp" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_cnc_job_list" model="ir.ui.view">
        <field name="name">rwasi.cnc.job.list</field>
        <field name="model">rwasi.cnc.job</field>
        <field name="arch" type="xml">
