                <field name="project_ref"/>
                <field name="machine"/>
                <field name="due_date"/>
            </list>
        </field>
    </record>
    <record id="action_cnc_job" model="ir.actions.act_window">
        <field name="name">أمر شغل CNC</field>
        <field name="res_model">rwasi.cnc.job</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
