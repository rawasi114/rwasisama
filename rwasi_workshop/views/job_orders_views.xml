<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RS-WS-11 أمر شغل نجارة -->
    <record id="view_carpentry_job_form" model="ir.ui.view">
        <field name="name">rwasi.carpentry.job.form</field>
        <field name="model">rwasi.carpentry.job</field>
        <field name="arch" type="xml">
            <form string="أمر شغل نجارة">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_ref"/>
                            <field name="work_order_id"/>
                        </group>
                        <group>
                            <field name="approved_dwg"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <group string="تفاصيل العنصر الخشبي">
                        <group>
                            <field name="element"/>
                            <field name="wood_type"/>
                            <field name="thickness"/>
                            <field name="veneer_finish"/>
                        </group>
                        <group>
                            <field name="counter_top"/>
                            <field name="dimensions"/>
                            <field name="qty"/>
                            <field name="hardware"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="مراحل التنفيذ">
                            <field name="stage_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="stage"/>
                                    <field name="assigned_to"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="status"/>
                                </list>
                            </field>
                            <field name="carpenter_notes" placeholder="ملاحظات النجار / المشرف..."/>
                        </page>
                        <page string="الاعتماد">
                            <group>
                                <group string="معد النموذج">
                                    <field name="prepared_name"/>
                                    <field name="prepared_date"/>
                                    <field name="prepared_signature" widget="signature"/>
                                </group>
                                <group string="مشرف ورشة النجارة">
                                    <field name="supervisor_name"/>
                                    <field name="supervisor_date"/>
                                    <field name="supervisor_signature" widget="signature"/>
                                </group>
                                <group string="مدير العمليات">
                                    <field name="manager_name"/>
                                    <field name="manager_date"/>
                                    <field name="manager_signature" widget="signature"/>
                                    <field name="manager_stamp" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_carpentry_job_list" model="ir.ui.view">
        <field name="name">rwasi.carpentry.job.list</field>
        <field name="model">rwasi.carpentry.job</field>
        <field name="arch" type="xml">
            <list string="أوامر شغل نجارة">
                <field name="name"/>
                <field name="project_ref"/>
                <field name="element"/>
                <field name="due_date"/>
            </list>
        </field>
    </record>
    <record id="action_carpentry_job" model="ir.actions.act_window">
        <field name="name">أمر شغل نجارة</field>
        <field name="res_model">rwasi.carpentry.job</field>
        <field name="view_mode">list,form</field>
    </record>

