<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RS-WS-19 إذن خروج وتسليم -->
    <record id="view_delivery_note_form" model="ir.ui.view">
        <field name="name">rwasi.delivery.note.form</field>
        <field name="model">rwasi.delivery.note</field>
        <field name="arch" type="xml">
            <form string="إذن خروج وتسليم">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="work_order_id"/>
                            <field name="site"/>
                            <field name="consignee"/>
                        </group>
                        <group>
                            <field name="out_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="المواد المسلَّمة">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"/>
                                    <field name="item_ref"/>
                                    <field name="qty"/>
                                    <field name="uom"/>
                                    <field name="packing"/>
                                </list>
                            </field>
                        </page>
                        <page string="بيانات النقل">
                            <group>
                                <group>
                                    <field name="driver"/>
                                    <field name="driver_id_no"/>
                                </group>
                                <group>
                                    <field name="plate"/>
                                    <field name="carrier"/>
                                </group>
                            </group>
                        </page>
                        <page string="الاعتماد">
                            <group>
                                <group string="أمين المستودع">
                                    <field name="storekeeper_name"/>
                                    <field name="storekeeper_date"/>
                                    <field name="storekeeper_signature" widget="signature"/>
                                </group>
                                <group string="المستلم">
                                    <field name="consignee_name"/>
                                    <field name="consignee_phone"/>
                                    <field name="consignee_signature" widget="signature"/>
                                </group>
                                <group string="حارس البوابة / الأمن">
                                    <field name="gate_security_name"/>
                                    <field name="gate_security_signature" widget="signature"/>
                                    <field name="manager_stamp" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_delivery_note_list" model="ir.ui.view">
        <field name="name">rwasi.delivery.note.list</field>
        <field name="model">rwasi.delivery.note</field>
        <field name="arch" type="xml">
            <list string="أذونات الخروج والتسليم">
                <field name="name"/>
                <field name="work_order_id"/>
                <field name="consignee"/>
                <field name="out_date"/>
            </list>
        </field>
    </record>
    <record id="action_delivery_note" model="ir.actions.act_window">
        <field name="name">إذن خروج وتسليم</field>
        <field name="res_model">rwasi.delivery.note</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
