<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RS-WS-10 معاينة وتفصيل -->
    <record id="view_measurement_sheet_form" model="ir.ui.view">
        <field name="name">rwasi.measurement.sheet.form</field>
        <field name="model">rwasi.measurement.sheet</field>
        <field name="arch" type="xml">
            <form string="نموذج معاينة وتفصيل">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="site"/>
                            <field name="partner_id"/>
                            <field name="department"/>
                        </group>
                        <group>
                            <field name="survey_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="القياسات">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="location"/>
                                    <field name="element"/>
                                    <field name="length"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                    <field name="qty"/>
                                    <field name="total"/>
                                    <field name="uom"/>
                                </list>
                            </field>
                        </page>
                        <page string="رسم تفصيلي / مخطط">
                            <field name="sketch" widget="image" filename="sketch_filename"/>
                            <field name="sketch_filename" invisible="1"/>
                        </page>
                        <page string="الاعتماد">
                            <group>
                                <group string="القائم بالمعاينة">
                                    <field name="surveyor_name"/>
                                    <field name="surveyor_date"/>
                                    <field name="surveyor_signature" widget="signature"/>
                                </group>
                                <group string="مشرف الورشة">
                                    <field name="supervisor_name"/>
                                    <field name="supervisor_date"/>
                                    <field name="supervisor_signature" widget="signature"/>
                                </group>
                                <group string="مدير العمليات">
                                    <field name="manager_name"/>
                                    <field name="manager_date"/>
                                    <field name="manager_signature" widget="signature"/>
                                    <field name="manager_stamp" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_measurement_sheet_list" model="ir.ui.view">
        <field name="name">rwasi.measurement.sheet.list</field>
        <field name="model">rwasi.measurement.sheet</field>
        <field name="arch" type="xml">
            <list string="معاينة وتفصيل">
                <field name="name"/>
                <field name="site"/>
                <field name="partner_id"/>
                <field name="survey_date"/>
            </list>
        </field>
    </record>
    <record id="action_measurement_sheet" model="ir.actions.act_window">
        <field name="name">معاينة وتفصيل</field>
        <field name="res_model">rwasi.measurement.sheet</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
