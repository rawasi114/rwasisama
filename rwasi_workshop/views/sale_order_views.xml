<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- زر أوامر التصنيع على أمر البيع -->
    <record id="view_order_form_workshop" model="ir.ui.view">
        <field name="name">sale.order.form.workshop</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_work_orders" type="object"
                        class="oe_stat_button" icon="fa-wrench"
                        invisible="work_order_count == 0">
                    <field name="work_order_count" widget="statinfo" string="أوامر التصنيع"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- إعدادات تصنيع المنتج في الورشة -->
    <record id="product_template_form_workshop" model="ir.ui.view">
        <field name="name">product.template.form.workshop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="is_workshop_product"/>
                <field name="workshop_scope" invisible="not is_workshop_product"/>
            </xpath>
        </field>
    </record>

</odoo>
