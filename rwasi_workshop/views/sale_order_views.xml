<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- زر أوامر التصنيع على أمر البيع -->
    <record id="view_order_form_workshop" model="ir.ui.view">
        <field name="name">sale.order.form.workshop</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_work_orders" type="object"
                        class="oe_stat_button" icon="fa-wrench"
                        invisible="work_order_count == 0">
                    <field name="work_order_count" widget="statinfo" string="أوامر التصنيع"/>
                </button>
                <button name="action_view_workshop_payments" type="object"
                        class="oe_stat_button" icon="fa-money">
                    <field name="workshop_payment_count" widget="statinfo" string="دفعات العميل"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_view_workshop_payments" type="object"
                        string="استلام دفعة" class="btn-secondary"/>
            </xpath>
        </field>
    </record>

    <!-- تبويب تصنيع الورشة على بطاقة المنتج -->
    <record id="product_template_form_workshop" model="ir.ui.view">
        <field name="name">product.template.form.workshop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="تصنيع الورشة" name="rwasi_workshop">
                    <group>
                        <group string="إعدادات الورشة">
                            <field name="is_workshop_product"/>
                            <field name="workshop_scope"
                                   invisible="not is_workshop_product"/>
                        </group>
                        <group>
                            <div colspan="2" class="text-muted">
                                عند تفعيل «يُصنّع في الورشة» يُنشأ أمر تصنيع تلقائياً لهذا المنتج
                                عند تأكيد أي عرض سعر (أمر بيع) يحتوي عليه. وتُنسخ قائمة المواد أدناه
                                إلى أمر التصنيع لفحص توفّرها بالمخزون.
                            </div>
                        </group>
                    </group>
                    <separator string="مواد التصنيع (المواد الخام اللازمة لكل وحدة)"
                               invisible="not is_workshop_product"/>
                    <field name="workshop_material_ids" invisible="not is_workshop_product">
                        <list editable="bottom">
                            <field name="material_id"/>
                            <field name="qty"/>
                            <field name="uom_name"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- قوائم المواد: المنتجات المُعلَّمة بأنها تُصنّع في الورشة -->
    <record id="view_workshop_bom_list" model="ir.ui.view">
        <field name="name">product.template.workshop.bom.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="قوائم المواد">
                <field name="default_code"/>
                <field name="name"/>
                <field name="workshop_scope"/>
            </list>
        </field>
    </record>

    <record id="action_workshop_bom" model="ir.actions.act_window">
        <field name="name">قوائم المواد</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_workshop_product', '=', True)]</field>
        <field name="context">{'default_is_workshop_product': True}</field>
        <field name="view_id" ref="view_workshop_bom_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لا توجد منتجات ورشة بعد</p>
            <p>علّم المنتج بأنه «يُصنّع في الورشة» وأضف مواده في تبويب «تصنيع الورشة».</p>
        </field>
    </record>

</odoo>
