<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RS-WS-22 التقرير اليومي لموظف المبيعات -->
    <record id="view_sales_daily_report_form" model="ir.ui.view">
        <field name="name">rwasi.sales.daily.report.form</field>
        <field name="model">rwasi.sales.daily.report</field>
        <field name="arch" type="xml">
            <form string="التقرير اليومي لموظف المبيعات">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="sales_rep"/>
                            <field name="territory"/>
                        </group>
                        <group>
                            <field name="report_date"/>
                            <field name="reports_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الزيارات اليومية">
                            <field name="visit_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="visit_time"/>
                                    <field name="client"/>
                                    <field name="contact"/>
                                    <field name="visit_type"/>
                                    <field name="outcome"/>
                                    <field name="follow_up"/>
                                </list>
                            </field>
                        </page>
                        <page string="مؤشرات اليوم">
                            <group>
                                <group>
                                    <field name="kpi_visits"/>
                                    <field name="kpi_new_leads"/>
                                    <field name="kpi_quotations"/>
                                </group>
                                <group>
                                    <field name="kpi_po_closed"/>
                                    <field name="kpi_sales_value"/>
                                </group>
                            </group>
                        </page>
                        <page string="الفرص المفتوحة وخطة الغد">
                            <field name="pipeline_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="lead"/>
                                    <field name="value"/>
                                    <field name="close_pct"/>
                                    <field name="next_step"/>
                                </list>
                            </field>
                            <field name="issues_support" placeholder="المعوقات / الدعم المطلوب..."/>
                        </page>
                        <page string="الاعتماد">
                            <group>
                                <group string="موظف المبيعات">
                                    <field name="prepared_name"/>
                                    <field name="prepared_date"/>
                                    <field name="prepared_signature" widget="signature"/>
                                </group>
                                <group string="مشرف المبيعات">
                                    <field name="sales_supervisor_name"/>
                                    <field name="sales_supervisor_date"/>
                                    <field name="sales_supervisor_signature" widget="signature"/>
                                </group>
                                <group string="مدير المبيعات">
                                    <field name="sales_manager_name"/>
                                    <field name="sales_manager_date"/>
                                    <field name="sales_manager_signature" widget="signature"/>
                                    <field name="manager_stamp" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_sales_daily_report_list" model="ir.ui.view">
        <field name="name">rwasi.sales.daily.report.list</field>
        <field name="model">rwasi.sales.daily.report</field>
        <field name="arch" type="xml">
            <list string="تقارير المبيعات اليومية">
                <field name="name"/>
                <field name="sales_rep"/>
                <field name="territory"/>
                <field name="report_date"/>
            </list>
        </field>
    </record>
    <record id="action_sales_daily_report" model="ir.actions.act_window">
        <field name="name">التقرير اليومي للمبيعات</field>
        <field name="res_model">rwasi.sales.daily.report</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
