<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RS-WS-02 طلب مواد -->
    <record id="view_material_requisition_form" model="ir.ui.view">
        <field name="name">rwasi.material.requisition.form</field>
        <field name="model">rwasi.material.requisition</field>
        <field name="arch" type="xml">
            <form string="طلب مواد">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="work_order_id"/>
                            <field name="requesting_dept"/>
                            <field name="project_ref"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="request_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="المواد المطلوبة">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="description"/>
                                    <field name="spec"/>
                                    <field name="qty"/>
                                    <field name="uom"/>
                                    <field name="need_by"/>
                                </list>
                            </field>
                        </page>
                        <page string="سبب الطلب">
                            <group>
                                <group>
                                    <field name="just_work_order"/>
                                    <field name="just_replenishment"/>
                                    <field name="just_maintenance"/>
                                </group>
                                <group>
                                    <field name="just_sample"/>
                                    <field name="just_emergency"/>
                                </group>
                            </group>
                            <field name="note" placeholder="ملاحظات إضافية..."/>
                        </page>
                        <page string="الاعتماد">
                            <group>
                                <group string="معد الطلب">
                                    <field name="prepared_name"/>
                                    <field name="prepared_date"/>
                                    <field name="supervisor_section"/>
                                    <field name="prepared_signature" widget="signature"/>
                                </group>
                                <group string="مشرف الورشة">
                                    <field name="supervisor_name"/>
                                    <field name="supervisor_date"/>
                                    <field name="supervisor_signature" widget="signature"/>
                                </group>
                                <group string="مدير العمليات">
                                    <field name="manager_name"/>
                                    <field name="manager_date"/>
                                    <field name="manager_signature" widget="signature"/>
                                    <field name="manager_stamp" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_material_requisition_list" model="ir.ui.view">
        <field name="name">rwasi.material.requisition.list</field>
        <field name="model">rwasi.material.requisition</field>
        <field name="arch" type="xml">
            <list string="طلبات المواد">
                <field name="name"/>
                <field name="work_order_id"/>
                <field name="requesting_dept"/>
                <field name="request_date"/>
            </list>
        </field>
    </record>
    <record id="action_material_requisition" model="ir.actions.act_window">
        <field name="name">طلب مواد</field>
        <field name="res_model">rwasi.material.requisition</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- RS-WS-03 استلام مواد -->
    <record id="view_material_receipt_form" model="ir.ui.view">
        <field name="name">rwasi.material.receipt.form</field>
        <field name="model">rwasi.material.receipt</field>
        <field name="arch" type="xml">
            <form string="استلام مواد من المستودع">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="work_order_id"/>
                            <field name="supplier_id"/>
                            <field name="po_number"/>
                        </group>
                        <group>
                            <field name="invoice_no"/>
                            <field name="received_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="بنود الاستلام">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_code"/>
                                    <field name="description"/>
                                    <field name="po_qty"/>
                                    <field name="recv_qty"/>
                                    <field name="uom"/>
                                    <field name="conformance"/>
                                </list>
                            </field>
                        </page>
                        <page string="حالة الاستلام والفحص الظاهري">
                            <group>
                                <group>
                                    <field name="insp_conforming"/>
                                    <field name="insp_conditional"/>
                                    <field name="insp_rejected"/>
                                    <field name="insp_coc_attached"/>
                                </group>
                                <group>
                                    <field name="insp_damaged"/>
                                    <field name="insp_short_qty"/>
                                    <field name="insp_over_qty"/>
                                    <field name="insp_lab_cert"/>
                                    <field name="insp_mtc_sheet"/>
                                </group>
                            </group>
                            <field name="inspection_notes" placeholder="ملاحظات الفحص..."/>
                        </page>
                        <page string="الاعتماد">
                            <group>
                                <group string="أمين المستودع">
                                    <field name="prepared_name"/>
                                    <field name="prepared_date"/>
                                    <field name="storekeeper_id_no"/>
                                    <field name="prepared_signature" widget="signature"/>
                                </group>
                                <group string="مهندس الجودة">
                                    <field name="supervisor_name"/>
                                    <field name="supervisor_date"/>
                                    <field name="qc_ref"/>
                                    <field name="supervisor_signature" widget="signature"/>
                                </group>
                                <group string="مدير العمليات">
                                    <field name="manager_name"/>
                                    <field name="manager_date"/>
                                    <field name="manager_signature" widget="signature"/>
                                    <field name="manager_stamp" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_material_receipt_list" model="ir.ui.view">
        <field name="name">rwasi.material.receipt.list</field>
        <field name="model">rwasi.material.receipt</field>
        <field name="arch" type="xml">
            <list string="استلام مواد">
                <field name="name"/>
                <field name="work_order_id"/>
                <field name="supplier_id"/>
                <field name="received_on"/>
            </list>
        </field>
    </record>
    <record id="action_material_receipt" model="ir.actions.act_window">
        <field name="name">استلام مواد</field>
        <field name="res_model">rwasi.material.receipt</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- RS-WS-04 صرف مواد للورشة -->
    <record id="view_material_issue_form" model="ir.ui.view">
        <field name="name">rwasi.material.issue.form</field>
        <field name="model">rwasi.material.issue</field>
        <field name="arch" type="xml">
            <form string="صرف مواد للورشة">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="requisition_id"/>
                            <field name="workshop"/>
                            <field name="receiver"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="المواد المنصرفة">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_code"/>
                                    <field name="description"/>
                                    <field name="uom"/>
                                    <field name="issued"/>
                                    <field name="returned"/>
                                    <field name="net"/>
                                    <field name="bin_card"/>
                                </list>
                            </field>
                        </page>
                        <page string="تخصيص التكلفة">
                            <group>
                                <group>
                                    <field name="project_no"/>
                                    <field name="cost_center"/>
                                </group>
                                <group>
                                    <field name="boq_item"/>
                                    <field name="job_no"/>
                                </group>
                            </group>
                        </page>
                        <page string="الاعتماد">
                            <group>
                                <group string="أمين المستودع">
                                    <field name="prepared_name"/>
                                    <field name="prepared_date"/>
                                    <field name="prepared_signature" widget="signature"/>
                                </group>
                                <group string="المستلم - مشرف الورشة">
                                    <field name="supervisor_name"/>
                                    <field name="supervisor_date"/>
                                    <field name="receiver_id_no"/>
                                    <field name="supervisor_signature" widget="signature"/>
                                </group>
                                <group string="مدير العمليات">
                                    <field name="manager_name"/>
                                    <field name="manager_date"/>
                                    <field name="manager_signature" widget="signature"/>
                                    <field name="manager_stamp" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_material_issue_list" model="ir.ui.view">
        <field name="name">rwasi.material.issue.list</field>
        <field name="model">rwasi.material.issue</field>
        <field name="arch" type="xml">
            <list string="صرف مواد">
                <field name="name"/>
                <field name="requisition_id"/>
                <field name="workshop"/>
                <field name="issue_date"/>
            </list>
        </field>
    </record>
    <record id="action_material_issue" model="ir.actions.act_window">
        <field name="name">صرف مواد للورشة</field>
        <field name="res_model">rwasi.material.issue</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- RS-WS-21 طلب مواد مرتبط بأمر البيع -->
    <record id="view_material_request_form" model="ir.ui.view">
        <field name="name">rwasi.material.request.form</field>
        <field name="model">rwasi.material.request</field>
        <field name="arch" type="xml">
            <form string="طلب مواد (مرتبط بأمر البيع)">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="requested_by"/>
                            <field name="project_ref"/>
                            <field name="related_so_id"/>
                        </group>
                        <group>
                            <field name="work_order_id"/>
                            <field name="request_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="المواد المطلوبة">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="so_item_ref"/>
                                    <field name="description"/>
                                    <field name="spec"/>
                                    <field name="qty"/>
                                    <field name="uom"/>
                                    <field name="need_by"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="سبب الطلب">
                            <group>
                                <group>
                                    <field name="just_project"/>
                                    <field name="just_replenishment"/>
                                </group>
                                <group>
                                    <field name="just_maintenance"/>
                                    <field name="just_emergency"/>
                                </group>
                            </group>
                        </page>
                        <page string="الاعتماد">
                            <group>
                                <group string="طالب الصرف">
                                    <field name="prepared_name"/>
                                    <field name="prepared_date"/>
                                    <field name="prepared_signature" widget="signature"/>
                                </group>
                                <group string="المراجع المالي">
                                    <field name="finance_name"/>
                                    <field name="finance_date"/>
                                    <field name="finance_signature" widget="signature"/>
                                </group>
                                <group string="معتمد من الإدارة">
                                    <field name="manager_name"/>
                                    <field name="manager_date"/>
                                    <field name="manager_signature" widget="signature"/>
                                    <field name="manager_stamp" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_material_request_list" model="ir.ui.view">
        <field name="name">rwasi.material.request.list</field>
        <field name="model">rwasi.material.request</field>
        <field name="arch" type="xml">
            <list string="طلبات مواد">
                <field name="name"/>
                <field name="related_so_id"/>
                <field name="requested_by"/>
                <field name="request_date"/>
            </list>
        </field>
    </record>
    <record id="action_material_request" model="ir.actions.act_window">
        <field name="name">طلب مواد (SO)</field>
        <field name="res_model">rwasi.material.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
