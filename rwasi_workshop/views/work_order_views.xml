<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_work_order_list" model="ir.ui.view">
        <field name="name">rwasi.work.order.list</field>
        <field name="model">rwasi.work.order</field>
        <field name="arch" type="xml">
            <list string="أوامر التصنيع" decoration-info="state == 'confirmed'" decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="workshop_scope"/>
                <field name="required_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_work_order_form" model="ir.ui.view">
        <field name="name">rwasi.work.order.form</field>
        <field name="model">rwasi.work.order</field>
        <field name="arch" type="xml">
            <form string="أمر تشغيل / تصنيع">
                <header>
                    <button name="action_request_materials" string="إنشاء طلب عرض سعر" type="object"
                            class="btn-primary"
                            invisible="state != 'draft' or materials_available or purchase_order_count &gt; 0 or not material_line_ids"/>
                    <button name="action_send_rfq" string="إرسال عرض السعر" type="object"
                            invisible="state != 'draft' or not has_draft_rfq"/>
                    <button name="action_confirm_purchase" string="تأكيد الطلب" type="object"
                            class="btn-primary"
                            invisible="state != 'draft' or not has_rfq_to_confirm"/>
                    <button name="action_receive_materials" string="استلام المواد" type="object"
                            class="btn-primary"
                            invisible="state != 'draft' or not has_pending_receipt"/>
                    <button name="action_confirm" string="تأكيد التصنيع" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_production" string="بدء التصنيع" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_finish_production" string="إنهاء التصنيع" type="object"
                            class="btn-primary" invisible="state != 'in_production'"/>
                    <button name="action_deliver" string="التسليم للعميل" type="object"
                            class="btn-primary" invisible="state != 'finished'"/>
                    <button name="action_close" string="إغلاق" type="object"
                            invisible="state != 'delivered'"/>
                    <button name="action_draft" string="إعادة لمسودة" type="object"
                            invisible="state in ('draft', 'cancel')"/>
                    <button name="action_cancel" string="إلغاء" type="object"
                            invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_production,finished,delivered,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo" string="طلبات الشراء"/>
                        </button>
                        <button name="action_view_delivery" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="delivery_count == 0">
                            <field name="delivery_count" widget="statinfo" string="أمر التسليم"/>
                        </button>
                        <button name="action_view_closeout" type="object"
                                class="oe_stat_button" icon="fa-flag-checkered"
                                invisible="closeout_count == 0">
                            <field name="closeout_count" widget="statinfo" string="إغلاق المشروع"/>
                        </button>
                    </div>
                    <field name="has_draft_rfq" invisible="1"/>
                    <field name="has_rfq_to_confirm" invisible="1"/>
                    <field name="has_pending_receipt" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="بيانات الأمر">
                            <field name="sale_order_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="workshop_scope"/>
                            <field name="priority"/>
                        </group>
                        <group string="المشروع والمواعيد">
                            <field name="project_ref"/>
                            <field name="project_code"/>
                            <field name="date_issued"/>
                            <field name="start_date"/>
                            <field name="required_date"/>
                            <field name="est_duration"/>
                            <field name="drawing_ref"/>
                            <field name="materials_available" readonly="1"/>
                        </group>
                    </group>
                    <field name="scope_of_work" placeholder="وصف العمل المطلوب..."/>
                    <notebook>
                        <page string="المواد اللازمة" name="materials">
                            <field name="material_line_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-danger="not is_available" decoration-success="is_available">
                                    <field name="material_id"/>
                                    <field name="vendor_id"/>
                                    <field name="qty_needed"/>
                                    <field name="qty_available"/>
                                    <field name="uom_name"/>
                                    <field name="is_available"/>
                                </list>
                            </field>
                            <separator string="طلبات عرض السعر / الشراء"/>
                            <field name="purchase_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="بنود التنفيذ" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"/>
                                    <field name="qty"/>
                                    <field name="uom"/>
                                    <field name="item_ref"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="المتطلبات والاشتراطات" name="requirements">
                            <group>
                                <group>
                                    <field name="req_approved_dwgs"/>
                                    <field name="req_sample_approved"/>
                                    <field name="req_material_approval"/>
                                </group>
                                <group>
                                    <field name="req_third_party_test"/>
                                    <field name="req_site_install"/>
                                    <field name="req_special_packing"/>
                                </group>
                            </group>
                        </page>
                        <page string="التسليم وتوقيع العميل" name="delivery">
                            <group>
                                <group>
                                    <field name="customer_sign_name"/>
                                    <field name="customer_sign_date"/>
                                </group>
                                <group>
                                    <field name="customer_signature" widget="signature"/>
                                </group>
                            </group>
                        </page>
                        <page string="الاعتماد" name="signoff">
                            <group>
                                <group string="معد النموذج">
                                    <field name="prepared_name"/>
                                    <field name="prepared_date"/>
                                    <field name="prepared_phone"/>
                                    <field name="prepared_signature" widget="signature"/>
                                </group>
                                <group string="مشرف الورشة">
                                    <field name="supervisor_name"/>
                                    <field name="supervisor_date"/>
                                    <field name="supervisor_section"/>
                                    <field name="supervisor_signature" widget="signature"/>
                                </group>
                                <group string="مدير العمليات">
                                    <field name="manager_name"/>
                                    <field name="manager_date"/>
                                    <field name="manager_signature" widget="signature"/>
                                    <field name="manager_stamp" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_work_order_search" model="ir.ui.view">
        <field name="name">rwasi.work.order.search</field>
        <field name="model">rwasi.work.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="filter_draft" string="مسودة" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_in_production" string="قيد التصنيع" domain="[('state', '=', 'in_production')]"/>
                <filter name="filter_delivered" string="تم التسليم" domain="[('state', '=', 'delivered')]"/>
                <group>
                    <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                    <filter name="group_scope" string="القسم" context="{'group_by': 'workshop_scope'}"/>
                    <filter name="group_partner" string="العميل" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_work_order" model="ir.actions.act_window">
        <field name="name">أوامر التصنيع</field>
        <field name="res_model">rwasi.work.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_work_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لا توجد أوامر تصنيع بعد</p>
            <p>تُنشأ أوامر التصنيع تلقائياً عند تأكيد أمر بيع يحتوي منتجات يتم تصنيعها في الورشة.</p>
        </field>
    </record>

</odoo>
