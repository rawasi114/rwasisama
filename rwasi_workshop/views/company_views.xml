<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_workshop" model="ir.ui.view">
        <field name="name">res.company.form.workshop</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="إعدادات الورشة" name="rwasi_workshop">
                    <field name="workshop_auto_mo"/>
                    <field name="workshop_warehouse_id"
                           domain="[('company_id', '=', id)]"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
