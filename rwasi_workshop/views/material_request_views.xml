<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ طلب المواد ============ -->
    <record id="view_material_request_list" model="ir.ui.view">
        <field name="name">rwasi.material.request.list</field>
        <field name="model">rwasi.material.request</field>
        <field name="arch" type="xml">
            <list string="طلبات المواد"
                  decoration-info="state == 'to_approve'"
                  decoration-warning="state in ('to_finance','to_revise')"
                  decoration-success="state == 'handover_done'"
                  decoration-muted="state in ('cancel','rejected')">
                <field name="name"/>
                <field name="work_order_id"/>
                <field name="work_job_id"/>
                <field name="partner_id"/>
                <field name="reason"/>
                <field name="request_date"/>
                <field name="material_approver_assignee_id" string="المُسنَد"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_material_request_form" model="ir.ui.view">
        <field name="name">rwasi.material.request.form</field>
        <field name="model">rwasi.material.request</field>
        <field name="arch" type="xml">
            <form string="طلب مواد">
                <header>
                    <button name="action_open_submit_wizard" string="رفع للاعتماد"
                            type="object" class="btn-primary"
                            invisible="state not in ('draft','to_revise') or not line_ids or paid_ratio &lt; 0.5"/>
                    <button name="action_open_approve_wizard"
                            string="اعتماد وإرسال للحسابات"
                            type="object" class="btn-primary"
                            invisible="state != 'to_approve' or not can_approve_materials"/>
                    <button name="action_open_finance_wizard"
                            string="اعتماد التمويل وإرسال للمشتريات"
                            type="object" class="btn-primary"
                            invisible="state != 'to_finance' or not can_handle_finance"/>
                    <button name="action_reject_materials" string="رفض" type="object"
                            invisible="(state != 'to_approve' or not can_approve_materials) and (state != 'to_finance' or not can_handle_finance)"/>
                    <button name="action_revise_materials" string="إعادة للتعديل"
                            type="object"
                            invisible="(state != 'to_approve' or not can_approve_materials) and (state != 'to_finance' or not can_handle_finance)"/>
                    <button name="action_handover_materials" string="تسليم المواد للورشة"
                            type="object" class="btn-primary"
                            invisible="state != 'approved' or not can_handle_purchase"/>
                    <button name="action_cancel" string="إلغاء" type="object"
                            invisible="state in ('approved','handover_done','cancel')"/>
                    <button name="action_draft" string="إعادة لمسودة" type="object"
                            invisible="state in ('draft','approved','handover_done','cancel')"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,to_approve,to_finance,approved,handover_done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo"
                                   string="طلبات الشراء"/>
                        </button>
                    </div>
                    <field name="paid_ratio" invisible="1"/>
                    <field name="can_approve_materials" invisible="1"/>
                    <field name="can_handle_finance" invisible="1"/>
                    <field name="can_handle_purchase" invisible="1"/>
                    <field name="materials_available" invisible="1"/>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'draft' or paid_ratio &gt;= 0.5">
                        بانتظار سداد ≥ 50% من قيمة أمر البيع لرفع الطلب للاعتماد.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'to_approve'">
                        الطلب بانتظار اعتماد مشرف الورشة.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'to_finance'">
                        اعتمده مشرف الورشة، بانتظار اعتماد الحسابات وتوفير السيولة.
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="state != 'approved'">
                        اعتمدت الحسابات التمويل وأُسند الطلب لموظف المشتريات.
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="state != 'handover_done'">
                        سُلّمت المواد للورشة.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'rejected'">
                        الطلب مرفوض (انظر السبب أدناه).
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'to_revise'">
                        أُعيد الطلب للتعديل (انظر السبب أدناه).
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="work_order_id" readonly="1"/>
                            <field name="work_job_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_date" readonly="1"/>
                            <field name="reason" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="المواد المطلوبة" name="materials">
                            <field name="line_ids"
                                   readonly="state not in ('draft','to_revise')">
                                <list editable="bottom"
                                      decoration-danger="not is_available"
                                      decoration-success="is_available">
                                    <field name="material_id"/>
                                    <field name="vendor_id"/>
                                    <field name="qty_needed"/>
                                    <field name="qty_available"/>
                                    <field name="uom_name"/>
                                    <field name="is_available"/>
                                </list>
                            </field>
                            <field name="note" placeholder="ملاحظات إضافية..."/>
                        </page>
                        <page string="الإسناد والاعتمادات" name="approvals">
                            <group>
                                <group string="مشرف الورشة">
                                    <field name="material_approver_assignee_id"
                                           readonly="1"/>
                                    <field name="material_approver_id" readonly="1"
                                           invisible="state in ('draft','to_approve')"/>
                                </group>
                                <group string="الحسابات">
                                    <field name="finance_user_id" readonly="1"
                                           invisible="state in ('draft','to_approve')"/>
                                    <field name="finance_approver_id" readonly="1"
                                           invisible="state in ('draft','to_approve','to_finance')"/>
                                    <field name="finance_approval_date" readonly="1"
                                           invisible="state in ('draft','to_approve','to_finance')"/>
                                </group>
                                <group string="المشتريات">
                                    <field name="purchase_user_id" readonly="1"
                                           invisible="state in ('draft','to_approve','to_finance')"/>
                                </group>
                                <group string="سبب الرفض / الإعادة"
                                       invisible="state not in ('to_approve','to_finance','rejected','to_revise')">
                                    <field name="approval_reason" nolabel="1"
                                           readonly="state not in ('to_approve','to_finance')"
                                           placeholder="يكتبه المسؤول عند الرفض أو الإعادة..."/>
                                </group>
                            </group>
                        </page>
                        <page string="تسليم المواد للورشة" name="handover"
                              invisible="state not in ('approved','handover_done')">
                            <group>
                                <field name="material_received_by"
                                       readonly="material_handover_done"/>
                                <field name="material_handover_signature" widget="signature"
                                       readonly="material_handover_done"/>
                                <field name="material_handover_date" readonly="1"
                                       invisible="not material_handover_done"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_material_request_search" model="ir.ui.view">
        <field name="name">rwasi.material.request.search</field>
        <field name="model">rwasi.material.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="work_order_id"/>
                <field name="work_job_id"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="مسودة" domain="[('state','=','draft')]"/>
                <filter name="filter_to_approve" string="بانتظار المشرف"
                        domain="[('state','=','to_approve')]"/>
                <filter name="filter_to_finance" string="بانتظار الحسابات"
                        domain="[('state','=','to_finance')]"/>
                <filter name="filter_approved" string="معتمد للشراء"
                        domain="[('state','=','approved')]"/>
                <filter name="filter_my_approvals" string="بانتظاري"
                        domain="['|', ('material_approver_assignee_id','=',uid),
                                 '|', ('finance_user_id','=',uid),
                                 ('purchase_user_id','=',uid)]"/>
                <group>
                    <filter name="group_state" string="الحالة"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_wo" string="أمر التصنيع"
                            context="{'group_by': 'work_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_material_request" model="ir.actions.act_window">
        <field name="name">طلبات المواد</field>
        <field name="res_model">rwasi.material.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_material_request_search"/>
    </record>

    <!-- معالج إسناد طلب المواد (3 أوضاع) -->
    <record id="view_material_request_wizard_form" model="ir.ui.view">
        <field name="name">rwasi.material.request.wizard.form</field>
        <field name="model">rwasi.material.request.wizard</field>
        <field name="arch" type="xml">
            <form string="إسناد">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="mode" invisible="1"/>
                    <field name="note" readonly="1" nolabel="1"/>
                    <field name="user_id"/>
                </group>
                <footer>
                    <button name="action_confirm" string="تأكيد" type="object"
                            class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
