<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="module_category_rwasi" model="ir.module.category">
        <field name="name">ورشة رواسي سما</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_workshop_user" model="res.groups">
        <field name="name">موظف / مشرف الورشة</field>
        <field name="category_id" ref="module_category_rwasi"/>
        <field name="comment">يدير نماذج الورشة لكن لا يمكنه إنشاء أمر تصنيع يدوياً.</field>
    </record>

    <record id="group_workshop_manager" model="res.groups">
        <field name="name">مدير العمليات</field>
        <field name="category_id" ref="module_category_rwasi"/>
        <field name="implied_ids" eval="[(4, ref('group_workshop_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">صلاحيات كاملة بما فيها إنشاء وحذف أوامر التصنيع.</field>
    </record>

</odoo>
