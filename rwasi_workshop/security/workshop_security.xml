<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_rwasi" model="ir.module.category">
        <field name="name">ورشة رواسي سما</field>
        <field name="sequence">20</field>
    </record>

    <!-- في Odoo 19 انتقلت الفئة من res.groups إلى res.groups.privilege -->
    <record id="privilege_rwasi" model="res.groups.privilege">
        <field name="name">ورشة رواسي سما</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_rwasi"/>
    </record>

    <record id="group_workshop_user" model="res.groups">
        <field name="name">موظف / مشرف الورشة</field>
        <field name="privilege_id" ref="privilege_rwasi"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_workshop_manager" model="res.groups">
        <field name="name">مدير العمليات</field>
        <field name="privilege_id" ref="privilege_rwasi"/>
        <field name="implied_ids" eval="[(4, ref('group_workshop_user'))]"/>
    </record>

    <!-- في Odoo 19 أُزيل حقل users من res.groups؛ يُسند المستخدم عبر group_ids على res.users -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_workshop_manager'))]"/>
    </record>

</odoo>
