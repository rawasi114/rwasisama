<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- مجموعات موديول المقاولات (تحت امتياز «رواسي» من rawasi_base) -->

        <record id="group_technical_office" model="res.groups">
            <field name="name">المكتب الفني</field>
            <field name="privilege_id" ref="rawasi_base.privilege_rawasi"/>
        </record>

        <record id="group_site_engineer" model="res.groups">
            <field name="name">مهندس موقع</field>
            <field name="privilege_id" ref="rawasi_base.privilege_rawasi"/>
        </record>

        <record id="group_project_manager" model="res.groups">
            <field name="name">مدير مشروع مقاولات</field>
            <field name="privilege_id" ref="rawasi_base.privilege_rawasi"/>
            <field name="implied_ids" eval="[
                (4, ref('group_site_engineer')),
                (4, ref('group_technical_office')),
            ]"/>
        </record>

        <!-- أدمن رواسي يحصل تلقائياً على أدوار المقاولات -->
        <record id="rawasi_base.group_rawasi_admin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_project_manager'))]"/>
        </record>

    </data>
</odoo>
