<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_material_request_list" model="ir.ui.view">
            <field name="name">rawasi.material.request.list</field>
            <field name="model">rawasi.material.request</field>
            <field name="arch" type="xml">
                <list string="طلبات المواد" decoration-info="state == 'in_purchase'"
                      decoration-success="state == 'issued'"
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="requester_id"/>
                    <field name="urgency"/>
                    <field name="amount_estimate"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'issued'"
                           decoration-info="state in ('approved_budget','in_purchase')"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_material_request_form" model="ir.ui.view">
            <field name="name">rawasi.material.request.form</field>
            <field name="model">rawasi.material.request</field>
            <field name="arch" type="xml">
                <form string="طلب مواد">
                    <header>
                        <button name="action_approve_supervisor" type="object"
                                string="اعتماد المشرف" class="btn-primary"
                                invisible="state != 'draft'"
                                groups="group_site_engineer,group_project_manager"/>
                        <button name="action_approve_budget" type="object"
                                string="اعتماد الحسابات" class="btn-primary"
                                invisible="state != 'approved_supervisor'"
                                groups="rawasi_base.group_rawasi_accountant"/>
                        <button name="action_forward_purchase" type="object"
                                string="تحويل للمشتريات" class="btn-primary"
                                invisible="state != 'approved_budget'"
                                groups="rawasi_base.group_rawasi_procurement"/>
                        <button name="action_issue" type="object"
                                string="صرف" class="btn-primary"
                                invisible="state != 'in_purchase'"/>
                        <button name="action_cancel" type="object" string="إلغاء"
                                invisible="state in ('issued','cancelled')"/>
                        <button name="action_reset_draft" type="object" string="إعادة لمسودة"
                                invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,approved_supervisor,approved_budget,in_purchase,issued"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="boq_item_id"
                                       domain="[('competition_id.project_id','=',project_id)]"/>
                                <field name="procurement_type"/>
                                <field name="requester_id"/>
                            </group>
                            <group>
                                <field name="urgency"/>
                                <field name="location_dest_id"/>
                                <field name="picking_id" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="البنود">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="reference_item_id"/>
                                        <field name="product_id"/>
                                        <field name="description"/>
                                        <field name="qty"/>
                                        <field name="uom_id"/>
                                        <field name="unit_cost"/>
                                        <field name="subtotal"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer">
                                    <field name="amount_estimate"/>
                                </group>
                            </page>
                            <page string="ملاحظات">
                                <field name="note"/>
                            </page>
                            <page string="التدقيق">
                                <group>
                                    <group>
                                        <field name="supervisor_user_id"/>
                                        <field name="supervisor_date"/>
                                        <field name="accountant_user_id"/>
                                        <field name="accountant_date"/>
                                    </group>
                                    <group>
                                        <field name="purchase_user_id"/>
                                        <field name="purchase_date"/>
                                        <field name="issuer_user_id"/>
                                        <field name="issue_date"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_material_request" model="ir.actions.act_window">
            <field name="name">طلبات المواد</field>
            <field name="res_model">rawasi.material.request</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_construction_operations" name="العمليات"
                  parent="menu_construction_root" sequence="20"/>
        <menuitem id="menu_material_request" name="طلبات المواد"
                  parent="menu_construction_operations" action="action_material_request" sequence="10"/>

    </data>
</odoo>
