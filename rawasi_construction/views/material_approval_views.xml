<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_material_approval_list" model="ir.ui.view">
            <field name="name">rawasi.material.approval.list</field>
            <field name="model">rawasi.material.approval</field>
            <field name="arch" type="xml">
                <list string="اعتمادات المواد"
                      decoration-success="state in ('approved', 'approved_as_noted')"
                      decoration-danger="state == 'rejected'"
                      decoration-warning="state == 'resubmit'">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="material_name"/>
                    <field name="manufacturer"/>
                    <field name="submittal_date"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_material_approval_form" model="ir.ui.view">
            <field name="name">rawasi.material.approval.form</field>
            <field name="model">rawasi.material.approval</field>
            <field name="arch" type="xml">
                <form string="اعتماد مواد">
                    <header>
                        <button name="action_submit" type="object" string="تقديم"
                                class="btn-primary" invisible="state not in ('draft', 'resubmit')"/>
                        <button name="action_approve" type="object" string="اعتماد"
                                class="btn-primary" invisible="state != 'submitted'"
                                groups="rawasi_construction.group_project_manager,rawasi_base.group_rawasi_admin"/>
                        <button name="action_approve_as_noted" type="object" string="اعتماد مع ملاحظات"
                                invisible="state != 'submitted'"
                                groups="rawasi_construction.group_project_manager,rawasi_base.group_rawasi_admin"/>
                        <button name="action_request_resubmit" type="object" string="إعادة تقديم"
                                invisible="state != 'submitted'"
                                groups="rawasi_construction.group_project_manager,rawasi_base.group_rawasi_admin"/>
                        <button name="action_reject" type="object" string="رفض"
                                invisible="state != 'submitted'"
                                groups="rawasi_construction.group_project_manager,rawasi_base.group_rawasi_admin"/>
                        <button name="action_reset_to_draft" type="object" string="إعادة لمسودة"
                                invisible="state not in ('rejected', 'resubmit')"/>
                        <button name="action_merge_attachments_pdf" type="object" string="دمج مرفقات PDF"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="boq_item_id"/>
                                <field name="material_name"/>
                                <field name="manufacturer"/>
                            </group>
                            <group>
                                <field name="supplier_id"/>
                                <field name="consultant_id"/>
                                <field name="submittal_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="المرفقات">
                                <field name="attachment_ids" widget="many2many_binary"/>
                                <group>
                                    <field name="merged_pdf" filename="merged_pdf_name"
                                           invisible="not merged_pdf"/>
                                    <field name="merged_pdf_name" invisible="1"/>
                                </group>
                            </page>
                            <page string="ملاحظات الاستشاري">
                                <field name="consultant_remarks" placeholder="ملاحظات الاستشاري..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_material_approval" model="ir.actions.act_window">
            <field name="name">اعتمادات المواد</field>
            <field name="res_model">rawasi.material.approval</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_material_approval" name="اعتمادات المواد"
                  parent="menu_construction_contracts" action="action_material_approval" sequence="20"/>

    </data>
</odoo>
