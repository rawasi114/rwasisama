<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_bg_list" model="ir.ui.view">
            <field name="name">rawasi.bank.guarantee.list</field>
            <field name="model">rawasi.bank.guarantee</field>
            <field name="arch" type="xml">
                <list string="خطابات الضمان" decoration-danger="days_to_expiry &lt; 30 and state == 'active'"
                      decoration-muted="state == 'released'">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="guarantee_type"/>
                    <field name="bank_id"/>
                    <field name="amount"/>
                    <field name="expiry_date"/>
                    <field name="days_to_expiry"/>
                    <field name="state" widget="badge"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_bg_form" model="ir.ui.view">
            <field name="name">rawasi.bank.guarantee.form</field>
            <field name="model">rawasi.bank.guarantee</field>
            <field name="arch" type="xml">
                <form string="خطاب ضمان">
                    <header>
                        <button name="action_release" type="object" string="إفراج"
                                class="btn-primary" invisible="state != 'active'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="guarantee_type"/>
                                <field name="bank_id"/>
                            </group>
                            <group>
                                <field name="amount"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                                <field name="issue_date"/>
                                <field name="expiry_date"/>
                                <field name="days_to_expiry"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_bg" model="ir.actions.act_window">
            <field name="name">خطابات الضمان</field>
            <field name="res_model">rawasi.bank.guarantee</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_bg" name="خطابات الضمان"
                  parent="menu_construction_contracts" action="action_bg" sequence="30"/>

    </data>
</odoo>
