<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_ipc_list" model="ir.ui.view">
            <field name="name">rawasi.ipc.list</field>
            <field name="model">rawasi.ipc</field>
            <field name="arch" type="xml">
                <list string="المستخلصات" decoration-success="state == 'paid'">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="ipc_number"/>
                    <field name="date_to"/>
                    <field name="amount_work"/>
                    <field name="net_amount"/>
                    <field name="state" widget="badge"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_ipc_form" model="ir.ui.view">
            <field name="name">rawasi.ipc.form</field>
            <field name="model">rawasi.ipc</field>
            <field name="arch" type="xml">
                <form string="مستخلص دوري">
                    <header>
                        <button name="action_submit" type="object" string="تقديم"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_approve" type="object" string="اعتماد"
                                class="btn-primary" invisible="state != 'submitted'"
                                groups="rawasi_base.group_rawasi_accountant"/>
                        <button name="action_mark_paid" type="object" string="تحديد كمدفوع"
                                class="btn-primary" invisible="state != 'approved'"
                                groups="rawasi_base.group_rawasi_accountant"/>
                        <button name="action_reset_draft" type="object" string="إعادة لمسودة"
                                invisible="state != 'submitted'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="ipc_number"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                            <group>
                                <field name="retention_pct"/>
                                <field name="advance_recovery"/>
                                <field name="previous_amount"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="بنود الإنجاز">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="boq_item_id"/>
                                        <field name="description"/>
                                        <field name="uom_id"/>
                                        <field name="contract_qty"/>
                                        <field name="previous_qty"/>
                                        <field name="current_qty"/>
                                        <field name="cumulative_qty"/>
                                        <field name="unit_price"/>
                                        <field name="amount"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group class="oe_subtotal_footer">
                            <field name="amount_work"/>
                            <field name="retention_amount"/>
                            <field name="net_amount" class="oe_subtotal_footer_separator"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_ipc" model="ir.actions.act_window">
            <field name="name">المستخلصات</field>
            <field name="res_model">rawasi.ipc</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_ipc" name="المستخلصات"
                  parent="menu_construction_contracts" action="action_ipc" sequence="20"/>

    </data>
</odoo>
