<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_bom_list" model="ir.ui.view">
            <field name="name">rawasi.bom.list</field>
            <field name="model">rawasi.bom</field>
            <field name="arch" type="xml">
                <list string="قوائم المواد">
                    <field name="name"/>
                    <field name="reference_item_id"/>
                    <field name="product_qty"/>
                    <field name="uom_id"/>
                    <field name="total_cost"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_bom_form" model="ir.ui.view">
            <field name="name">rawasi.bom.form</field>
            <field name="model">rawasi.bom</field>
            <field name="arch" type="xml">
                <form string="قائمة مواد">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="اسم القائمة"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="reference_item_id"/>
                            </group>
                            <group>
                                <field name="product_qty"/>
                                <field name="uom_id"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="المكوّنات">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="component_item_id"/>
                                        <field name="qty"/>
                                        <field name="uom_id"/>
                                        <field name="unit_cost"/>
                                        <field name="subtotal"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer">
                                    <field name="total_cost"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_bom" model="ir.actions.act_window">
            <field name="name">قوائم المواد (BoM)</field>
            <field name="res_model">rawasi.bom</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_bom" name="قوائم المواد"
                  parent="menu_construction_catalog" action="action_bom" sequence="20"/>

    </data>
</odoo>
