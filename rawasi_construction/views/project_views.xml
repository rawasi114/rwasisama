<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- إضافة حقول المقاولات إلى نموذج المشروع -->
        <record id="view_project_form_rawasi" model="ir.ui.view">
            <field name="name">project.project.form.rawasi</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="المقاولات" name="rawasi_construction"
                          invisible="not rawasi_is_construction">
                        <group>
                            <group>
                                <field name="rawasi_is_construction"/>
                                <field name="rawasi_code"/>
                                <field name="rawasi_competition_id" readonly="1"/>
                                <field name="rawasi_main_location_id"/>
                            </group>
                            <group>
                                <field name="rawasi_contract_value"/>
                                <field name="rawasi_currency_id" groups="base.group_multi_currency"/>
                                <field name="rawasi_date_start"/>
                                <field name="rawasi_date_end"/>
                            </group>
                        </group>
                        <field name="rawasi_boq_item_ids" readonly="1">
                            <list>
                                <field name="code"/>
                                <field name="description"/>
                                <field name="uom_id"/>
                                <field name="qty"/>
                                <field name="unit_price"/>
                                <field name="subtotal"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- لوحة الميزانية -->
        <record id="view_project_form_rawasi_budget" model="ir.ui.view">
            <field name="name">project.project.form.rawasi.budget</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="الميزانية" name="rawasi_budget"
                          invisible="not rawasi_is_construction">
                        <div class="alert alert-danger" role="alert"
                             invisible="not rawasi_budget_overrun">
                            <strong>تنبيه:</strong> تجاوز المصروف الفعلي التكلفة المقدّرة للمشروع.
                        </div>
                        <group>
                            <group string="الإيراد">
                                <field name="rawasi_contract_value"/>
                            </group>
                            <group string="التكلفة">
                                <field name="rawasi_budget_estimated_cost"/>
                                <field name="rawasi_budget_committed"/>
                                <field name="rawasi_budget_actual_spent"/>
                            </group>
                        </group>
                        <group>
                            <group string="المتبقّي والاستهلاك">
                                <field name="rawasi_budget_remaining"/>
                                <field name="rawasi_budget_consumption_pct"
                                       widget="percentage"/>
                                <field name="rawasi_budget_overrun" invisible="1"/>
                                <field name="rawasi_currency_id" invisible="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- العرض الموحَّد: أزرار ذكية لمهندس الموقع -->
        <record id="view_project_form_rawasi_buttons" model="ir.ui.view">
            <field name="name">project.project.form.rawasi.buttons</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_rawasi_material_requests" type="object"
                            class="oe_stat_button" icon="fa-cubes"
                            invisible="not rawasi_is_construction">
                        <field name="rawasi_material_request_count" widget="statinfo"
                               string="طلبات المواد"/>
                    </button>
                    <button name="action_rawasi_material_approvals" type="object"
                            class="oe_stat_button" icon="fa-check-square-o"
                            invisible="not rawasi_is_construction">
                        <field name="rawasi_material_approval_count" widget="statinfo"
                               string="اعتمادات المواد"/>
                    </button>
                    <button name="action_rawasi_dsrs" type="object"
                            class="oe_stat_button" icon="fa-calendar"
                            invisible="not rawasi_is_construction">
                        <field name="rawasi_dsr_count" widget="statinfo"
                               string="تقارير يومية"/>
                    </button>
                    <button name="action_rawasi_vos" type="object"
                            class="oe_stat_button" icon="fa-exchange"
                            invisible="not rawasi_is_construction">
                        <field name="rawasi_vo_count" widget="statinfo"
                               string="أوامر تغيير"/>
                    </button>
                    <button name="action_rawasi_ipcs" type="object"
                            class="oe_stat_button" icon="fa-money"
                            invisible="not rawasi_is_construction">
                        <field name="rawasi_ipc_count" widget="statinfo"
                               string="مستخلصات"/>
                    </button>
                    <button name="action_rawasi_subcontracts" type="object"
                            class="oe_stat_button" icon="fa-handshake-o"
                            invisible="not rawasi_is_construction">
                        <field name="rawasi_subcontract_count" widget="statinfo"
                               string="عقود فرعية"/>
                    </button>
                    <button name="action_rawasi_wbs" type="object"
                            class="oe_stat_button" icon="fa-tasks"
                            invisible="not rawasi_is_construction">
                        <field name="rawasi_wbs_count" widget="statinfo"
                               string="الجدول الزمني"/>
                    </button>
                </xpath>
            </field>
        </record>

        <!-- خانة لتفعيل علامة «مشروع مقاولات» في نموذج الإنشاء السريع -->
        <record id="view_project_form_rawasi_flag" model="ir.ui.view">
            <field name="name">project.project.form.rawasi.flag</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <field name="user_id" position="after">
                    <field name="rawasi_is_construction"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
