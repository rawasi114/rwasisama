<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_reference_item_list" model="ir.ui.view">
            <field name="name">rawasi.reference.item.list</field>
            <field name="model">rawasi.reference.item</field>
            <field name="arch" type="xml">
                <list string="البنود المرجعية">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="uom_id"/>
                    <field name="procurement_type"/>
                    <field name="standard_cost"/>
                    <field name="product_id"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_reference_item_form" model="ir.ui.view">
            <field name="name">rawasi.reference.item.form</field>
            <field name="model">rawasi.reference.item</field>
            <field name="arch" type="xml">
                <form string="بند مرجعي">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="اسم البند المرجعي"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="category"/>
                                <field name="uom_id"/>
                                <field name="procurement_type"/>
                            </group>
                            <group>
                                <field name="standard_cost"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                                <field name="product_id" readonly="1"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="المواصفات">
                            <field name="specification" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_reference_item_search" model="ir.ui.view">
            <field name="name">rawasi.reference.item.search</field>
            <field name="model">rawasi.reference.item</field>
            <field name="arch" type="xml">
                <search string="بحث البنود المرجعية">
                    <field name="name"/>
                    <field name="code"/>
                    <filter name="f_workshop" string="تصنيع داخلي"
                            domain="[('procurement_type','=','in_house_workshop')]"/>
                    <filter name="f_purchase" string="شراء خارجي"
                            domain="[('procurement_type','=','purchase')]"/>
                    <group name="group_by">
                        <filter name="g_category" string="التصنيف" context="{'group_by':'category'}"/>
                        <filter name="g_proc" string="مسار التوريد" context="{'group_by':'procurement_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_reference_item" model="ir.actions.act_window">
            <field name="name">البنود المرجعية (الكتالوج)</field>
            <field name="res_model">rawasi.reference.item</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_reference_item_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">أنشئ أول بند مرجعي</p>
                <p>الكتالوج المركزي — كل بند مرجعي يرتبط بمنتج مخزون واحد.</p>
            </field>
        </record>

        <menuitem id="menu_construction_catalog" name="الكتالوج"
                  parent="menu_construction_root" sequence="40"/>
        <menuitem id="menu_reference_item" name="البنود المرجعية"
                  parent="menu_construction_catalog" action="action_reference_item" sequence="10"/>

    </data>
</odoo>
