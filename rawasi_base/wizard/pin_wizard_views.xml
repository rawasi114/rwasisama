<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_rawasi_pin_wizard_form" model="ir.ui.view">
            <field name="name">rawasi.pin.wizard.form</field>
            <field name="model">rawasi.pin.wizard</field>
            <field name="arch" type="xml">
                <form string="تأكيد بالـ PIN">
                    <group>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                        <field name="method" invisible="1"/>
                        <field name="pin" password="True" placeholder="● ● ● ● ● ●"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="تأكيد" class="btn-primary"/>
                        <button string="إلغاء" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
