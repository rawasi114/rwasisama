<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List -->
        <record id="view_rawasi_equipment_list" model="ir.ui.view">
            <field name="name">rawasi.equipment.list</field>
            <field name="model">rawasi.equipment</field>
            <field name="arch" type="xml">
                <list string="الأصول الثابتة">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="custodian_user_id"/>
                    <field name="location_text"/>
                    <field name="purchase_date"/>
                    <field name="purchase_price"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Form -->
        <record id="view_rawasi_equipment_form" model="ir.ui.view">
            <field name="name">rawasi.equipment.form</field>
            <field name="model">rawasi.equipment</field>
            <field name="arch" type="xml">
                <form string="أصل ثابت">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="اسم الأصل"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="category"/>
                                <field name="custodian_user_id"/>
                                <field name="location_text"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="purchase_date"/>
                                <field name="purchase_price"/>
                                <field name="currency_id"/>
                                <field name="plate_number"/>
                                <field name="model"/>
                                <field name="serial_number"/>
                            </group>
                        </group>
                        <group string="الربط المحاسبي">
                            <field name="asset_account_id"/>
                            <field name="depreciation_account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="ملاحظات">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search -->
        <record id="view_rawasi_equipment_search" model="ir.ui.view">
            <field name="name">rawasi.equipment.search</field>
            <field name="model">rawasi.equipment</field>
            <field name="arch" type="xml">
                <search string="بحث الأصول">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="custodian_user_id"/>
                    <field name="plate_number"/>
                    <separator/>
                    <filter name="filter_vehicle" string="سيارات" domain="[('category','=','vehicle')]"/>
                    <filter name="filter_workshop" string="آلات ورشة" domain="[('category','=','workshop_machine')]"/>
                    <filter name="filter_site_tool" string="أدوات موقع" domain="[('category','=','site_tool')]"/>
                    <group expand="0" string="تجميع حسب">
                        <filter name="group_category" string="الفئة" context="{'group_by': 'category'}"/>
                        <filter name="group_custodian" string="العهدة" context="{'group_by': 'custodian_user_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_rawasi_equipment" model="ir.actions.act_window">
            <field name="name">الأصول الثابتة</field>
            <field name="res_model">rawasi.equipment</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_rawasi_equipment_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">سجِّل أول أصل ثابت</p>
                <p>أثاث ومعدات المكاتب، السيارات، آلات الورشة، وأدوات المواقع.</p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_rawasi_equipment"
                  name="الأصول الثابتة"
                  parent="menu_rawasi_root"
                  action="action_rawasi_equipment"
                  sequence="800"
                  groups="group_rawasi_admin,group_rawasi_accountant,group_rawasi_procurement"/>

    </data>
</odoo>
