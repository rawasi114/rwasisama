<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_rawasi_audit_trail_list" model="ir.ui.view">
            <field name="name">rawasi.audit.trail.list</field>
            <field name="model">rawasi.audit.trail</field>
            <field name="arch" type="xml">
                <list string="سجل التدقيق" create="false" edit="false" delete="false">
                    <field name="event_date"/>
                    <field name="event"/>
                    <field name="name"/>
                    <field name="model_name"/>
                    <field name="user_id"/>
                </list>
            </field>
        </record>

        <record id="view_rawasi_audit_trail_form" model="ir.ui.view">
            <field name="name">rawasi.audit.trail.form</field>
            <field name="model">rawasi.audit.trail</field>
            <field name="arch" type="xml">
                <form string="قيد تدقيق" create="false" edit="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="event"/>
                                <field name="event_date"/>
                                <field name="user_id"/>
                            </group>
                            <group>
                                <field name="model_name"/>
                                <field name="res_id"/>
                                <field name="res_name"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group string="السبب">
                            <field name="reason" nolabel="1"/>
                        </group>
                        <group string="التفاصيل">
                            <field name="detail" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_rawasi_audit_trail_search" model="ir.ui.view">
            <field name="name">rawasi.audit.trail.search</field>
            <field name="model">rawasi.audit.trail</field>
            <field name="arch" type="xml">
                <search string="بحث سجل التدقيق">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="model_name"/>
                    <filter name="f_override" string="تجاوز إداري" domain="[('event','=','override')]"/>
                    <filter name="f_approve" string="اعتمادات" domain="[('event','=','approve')]"/>
                    <group name="group_by">
                        <filter name="g_event" string="الحدث" context="{'group_by':'event'}"/>
                        <filter name="g_user" string="المستخدم" context="{'group_by':'user_id'}"/>
                        <filter name="g_model" string="النموذج" context="{'group_by':'model_name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_rawasi_audit_trail" model="ir.actions.act_window">
            <field name="name">سجل التدقيق</field>
            <field name="res_model">rawasi.audit.trail</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_rawasi_audit_trail_search"/>
            <field name="context">{'search_default_g_event': 1}</field>
        </record>

        <menuitem id="menu_rawasi_audit_trail" name="سجل التدقيق"
                  parent="menu_rawasi_configuration" action="action_rawasi_audit_trail"
                  sequence="50" groups="group_rawasi_admin"/>

    </data>
</odoo>
