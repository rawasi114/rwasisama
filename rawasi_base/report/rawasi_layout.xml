<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         قالب التقارير الموحَّد لرواسي سما.
         تستدعيه كل تقارير الموديولات الثلاثة بدل تكرار الهوية:

             <template id="report_xxx_document">
                 <t t-call="rawasi_base.rawasi_layout">
                     ... محتوى التقرير الذي يستخدم المتغير o ...
                 </t>
             </template>

         يلتف حول المحتوى بحاوية موحدة (RTL + هوية رواسي عبر SCSS)
         فوق التخطيط القياسي للشركة (web.external_layout).
         ================================================================ -->
    <template id="rawasi_layout">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page rawasi-report" dir="rtl">
                        <t t-out="0"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
